---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrossValidationResults from '../../components/CrossValidationResults.astro';
import EvidNeuroCaseStudy from '../../components/EvidNeuroCaseStudy.astro';
import MediaPreview from '../../components/MediaPreview.astro';
import NeuralEventChallenge from '../../components/NeuralEventChallenge.astro';
import NeuralEventConclusion from '../../components/NeuralEventConclusion.astro';
import NeuralEventPipeline from '../../components/NeuralEventPipeline.astro';
import NeuralModelArchitecture from '../../components/NeuralModelArchitecture.astro';
import RepresentativeEvents from '../../components/RepresentativeEvents.astro';
import RobustnessAblation from '../../components/RobustnessAblation.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { projects, type Project } from '../../data/portfolio';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project }
const { project } = Astro.props;
const isNeuralEventProject = project.slug === 'neural-event-classification';
const isEvidNeuroProject = project.slug === 'evidneuro';
---

<BaseLayout title={`${project.title} — Yixiong Sun`} description={project.description}>
  <div class="site-shell detail-shell">
    <SiteHeader />
    <main>
      <a class="back-link" href={withBase('work/')}>← All projects</a>
      <article class:list={['project-detail', { 'project-detail--evidneuro': isEvidNeuroProject }]}>
        <header>
          <span>{project.year}</span>
          <h1>{project.title}</h1>
          <p>{project.summary}</p>
          {isEvidNeuroProject && (
            <aside class="project-status" aria-label="Project status">
              <strong>Work in progress</strong>
              <span>
                EvidNeuro is an active research and engineering project. The repository is private,
                and a technical report/manuscript is in preparation.
              </span>
            </aside>
          )}
        </header>
        {isNeuralEventProject && (
          <div class="detail-copy detail-copy--lead">
            <h2>Overview</h2>
            <p>{project.description}</p>
            <h2>Tools</h2>
            <p>{project.tools.join(' · ')}</p>
            {project.url && (
              <>
                <h2>Source</h2>
                <p><a class="text-link" href={project.url}>View project on GitHub ↗</a></p>
              </>
            )}
          </div>
        )}
        {isEvidNeuroProject ? (
          <EvidNeuroCaseStudy />
        ) : isNeuralEventProject ? (
          <>
            <NeuralEventChallenge />
            <NeuralEventPipeline />
            <RepresentativeEvents />
            <NeuralModelArchitecture />
            <CrossValidationResults />
            <RobustnessAblation />
            <NeuralEventConclusion />
          </>
        ) : (
          project.media && <MediaPreview media={project.media} />
        )}
        {!isNeuralEventProject && !isEvidNeuroProject && (
          <div class="detail-copy">
            <h2>Overview</h2>
            <p>{project.description}</p>
            <h2>Tools</h2>
            <p>{project.tools.join(' · ')}</p>
            {project.url && (
              <>
                <h2>Source</h2>
                <p><a class="text-link" href={project.url}>View project on GitHub ↗</a></p>
              </>
            )}
          </div>
        )}
      </article>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
