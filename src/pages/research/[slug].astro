---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { Image } from 'astro:assets';
import { research, type ResearchItem } from '../../data/portfolio';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return research.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props { item: ResearchItem }
const { item } = Astro.props;
---

<BaseLayout title={`${item.title} — Yixiong Sun`} description={`${item.type} at ${item.venue}.`}>
  <div class="site-shell detail-shell">
    <SiteHeader />
    <main>
      <a class="back-link" href={withBase('research/')}>← Research archive</a>
      <article class="research-detail">
        <header>
          <div><span>{item.year}</span><span>{item.type}</span></div>
          <h1>{item.title}</h1>
          <p>{item.venue}{item.status ? ` · ${item.status}` : ''}</p>
        </header>
        {item.image && <Image class="poster-image" src={item.image} alt={`Poster for ${item.title}`} width={1100} format="webp" loading="lazy" />}
        <div class="detail-copy">
          {item.authors && <><h2>Authors</h2><p>{item.authors}</p></>}
          {item.pdf && <p><a class="text-link" href={withBase(item.pdf)}>View PDF ↗</a></p>}
          {item.url && <p><a class="text-link" href={item.url}>View publication ↗</a></p>}
        </div>
      </article>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
