---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPreview from '../components/MediaPreview.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { experience, projects } from '../data/portfolio';
import { withBase } from '../utils/paths';

const highlightedExperience = experience.filter((item) =>
  ['Takehara Lab, University of Toronto', 'iVenuto.com Corporation'].includes(item.organization),
);
const highlightedProjects = projects.filter((project) =>
  ['evidneuro', 'neural-event-classification'].includes(project.slug),
);
const neuralEventPreview = {
  type: 'image' as const,
  src: 'media/neural-event-classification/02_representative_events.svg',
  alt: 'Representative ripple, IED, and noise events shown as multichannel waveforms and spectrograms',
};
---

<BaseLayout
  title="Yixiong Sun — Neuroscience, machine learning, and software"
  description="Yixiong Sun is a systems neuroscience researcher and software engineer working on machine learning and signal processing for neural time-series data."
>
  <div class="site-shell">
    <SiteHeader />

    <main>
      <section class="intro" id="about">
        <p>Working at the intersection of neuroscience and AI, I develop computational approaches to reveal how the brain learns, forms memories, and constructs the representations that shape thought and behavior.</p>
        <p class="intro-detail">As a systems neuroscience PhD candidate, I study how memories are encoded and reorganized within hippocampal networks—and how these processes are disrupted in models of Alzheimer’s disease. I combine <em>in vivo</em> electrophysiology with machine learning, signal processing, and computational modeling to find meaningful structure in complex neural activity.</p>
        <p class="intro-detail">Beyond memory, I am interested in how the brain learns, plans, builds internal representations, and gives rise to conscious experience. My strength lies in connecting biological questions, experimental data, and computational methods to investigate how the brain works in both health and disease.</p>
        <div class="meta-links" aria-label="Profile links">
          <span>Toronto, Canada</span>
          <a href="mailto:yixiong.sun@mail.utoronto.ca">Email</a>
          <a href="https://github.com/yixiongsun">GitHub</a>
          <a href="https://www.linkedin.com/in/yixiong-sun-4b974b1b7/">LinkedIn</a>
        </div>
      </section>

      <section class="index-section" id="experience">
        <h2>Experience</h2>
        <div class="index-list">
          {highlightedExperience.map((item) => (
            <div class="index-row index-row-static">
              <span class="year">{item.period}</span>
              <span class="row-copy">
                <strong>{item.organization} · {item.role}</strong>
                <small>{item.summary}</small>
                <span class="row-tools">{item.tools.join(' · ')}</span>
              </span>
              <span aria-hidden="true"></span>
            </div>
          ))}
          <a class="section-link" href={withBase('experience/')}>
            <span>View all experience</span><span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="index-section" id="projects">
        <h2>Projects</h2>
        <div class="index-list">
          {highlightedProjects.map((project) => (
            <a
              class:list={[
                'index-row',
                {
                  'row-with-preview': project.media,
                  'neural-event-preview': project.slug === 'neural-event-classification',
                },
              ]}
              href={withBase(`work/${project.slug}/`)}
            >
              <span class="year">{project.year}</span>
              <span class="row-copy">
                <strong>{project.title}</strong>
                <small>{project.summary}</small>
              </span>
              <span class="arrow" aria-hidden="true">↗</span>
              {project.media && (
                <MediaPreview
                  media={project.slug === 'neural-event-classification' ? neuralEventPreview : project.media}
                  compact
                />
              )}
            </a>
          ))}
          <a class="section-link" href={withBase('work/')}>
            <span>View all projects</span><span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="index-section">
        <h2>Research</h2>
        <div class="index-list">
          <a class="index-row" href={withBase('research/')}>
            <span class="year">Archive</span>
            <span class="row-copy">
              <strong>Publications, posters, and presentations</strong>
              <small>Browse the complete research record by year and format</small>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
