---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPreview from '../components/MediaPreview.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { experience, projects } from '../data/portfolio';
import { withBase } from '../utils/paths';

const highlightedExperience = experience.filter((item) =>
  ['Takehara Lab, University of Toronto', 'iVenuto.com Corporation'].includes(item.organization),
);
const highlightedProjects = projects.filter((project) =>
  ['evidneuro', 'neural-event-classification'].includes(project.slug),
);
const neuralEventPreview = {
  type: 'image' as const,
  src: 'media/neural-event-classification/02_representative_events.svg',
  alt: 'Representative ripple, IED, and noise events shown as multichannel waveforms and spectrograms',
};
---

<BaseLayout
  title="Yixiong Sun — Systems neuroscience and computational research"
  description="Yixiong Sun studies memory, learning, and hippocampal network dynamics in Alzheimer’s disease, combining experimental neuroscience, machine learning, and computational modeling."
>
  <div class="site-shell">
    <SiteHeader />

    <main>
      <section class="intro" id="about">
        <p>I am a systems neuroscientist and computational researcher investigating how neural systems learn from experience, form memories, and build internal representations that guide behavior.</p>
        <p class="intro-detail">My PhD research focuses on how memories are encoded and reorganized within hippocampal networks, and how these processes break down in Alzheimer’s disease. I design and execute technically demanding chronic in vivo electrophysiology experiments in freely moving mice, building and implanting custom electrode arrays for recording and stimulation alongside behavioral testing. I integrate these experiments with advanced signal processing, machine learning, population-level analyses, and mechanistic circuit models to uncover how coordinated neural activity supports memory, how pathology reshapes network dynamics, and which mechanisms may restore circuit function.</p>
        <p class="intro-detail">More broadly, I am interested in how memories and internal representations evolve to support learning, prediction, and planning. I am especially drawn to the principles that make intelligent systems flexible: how experience reshapes representations, how existing knowledge incorporates new information, and how networks remain adaptive rather than becoming locked into fixed patterns. I approach these questions across biological circuits and computational models, using neuroscience and AI as complementary frameworks for understanding memory, learning, and adaptive behavior.</p>
        <div class="meta-links" aria-label="Profile links">
          <span>Toronto, Canada</span>
          <a href="mailto:yixiong.sun@mail.utoronto.ca">Email</a>
          <a href="https://github.com/yixiongsun">GitHub</a>
          <a href="https://www.linkedin.com/in/yixiong-sun-4b974b1b7/">LinkedIn</a>
        </div>
      </section>

      <section class="index-section" id="experience">
        <h2>Selected experience</h2>
        <div class="index-list">
          {highlightedExperience.map((item) => (
            <div class="index-row index-row-static">
              <span class="year">{item.period}</span>
              <span class="row-copy">
                <strong>{item.organization} · {item.role}</strong>
                <small>{item.summary}</small>
                <span class="row-tools">{item.tools.join(' · ')}</span>
              </span>
              <span aria-hidden="true"></span>
            </div>
          ))}
          <a class="section-link" href={withBase('experience/')}>
            <span>View all experience</span><span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="index-section" id="projects">
        <h2>Selected projects</h2>
        <div class="index-list">
          {highlightedProjects.map((project) => (
            <a
              class:list={[
                'index-row',
                {
                  'row-with-preview': project.media,
                  'neural-event-preview': project.slug === 'neural-event-classification',
                },
              ]}
              href={withBase(`projects/${project.slug}/`)}
            >
              <span class="year">{project.year}</span>
              <span class="row-copy">
                <strong>{project.title}</strong>
                <small>{project.summary}</small>
              </span>
              <span class="arrow" aria-hidden="true">↗</span>
              {project.media && (
                <MediaPreview
                  media={project.slug === 'neural-event-classification' ? neuralEventPreview : project.media}
                  compact
                />
              )}
            </a>
          ))}
          <a class="section-link" href={withBase('projects/')}>
            <span>View all projects</span><span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="index-section">
        <h2>Research outputs</h2>
        <div class="index-list">
          <a class="index-row" href={withBase('research/')}>
            <span class="year">Archive</span>
            <span class="row-copy">
              <strong>Publications, posters, and talks</strong>
              <small>Explore research on hippocampal networks, memory, and Alzheimer’s disease</small>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
