  .comparison-view-heading > span { padding-top: 2px; color: var(--text); font-size: 9px; text-transform: uppercase; letter-spacing: .08em; }
  .comparison-view-heading h4 { margin: 0; color: var(--text); font-size: 12px; line-height: 1.4; font-weight: 400; }
