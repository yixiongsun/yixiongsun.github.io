  .comparison-window-control { display: flex; align-items: center; gap: 8px; color: var(--text); font-size: 11px; white-space: nowrap; }
  .comparison-network-canvas, .comparison-current-canvas, .comparison-rate-canvas { display: block; width: 100%; border: 1px solid #292c28; background: #0f110f; }
  .comparison-network-canvas { height: 420px; cursor: crosshair; }
