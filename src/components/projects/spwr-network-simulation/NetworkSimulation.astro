---
import { withBase } from '../../../utils/paths';

const populations = [
  { id: 'pfc-py', label: 'PFC pyramidal', color: '#8f948d' },
  { id: 'pfc-in', label: 'PFC interneurons', color: '#8f948d' },
  { id: 'ca3-py', label: 'CA3 pyramidal', color: '#b9bdb7' },
  { id: 'ca3-in', label: 'CA3 interneurons', color: '#b9bdb7' },
  { id: 'ca1-py', label: 'CA1 pyramidal', color: '#e5e7e2' },
  { id: 'ca1-in', label: 'CA1 interneurons', color: '#e5e7e2' },
];
---

<section
  class="network-simulation"
  data-network-simulation
  data-manifest-url={withBase('data/pfc-hpc/default_sv0/manifest.json')}
  aria-labelledby="network-simulation-title"
  aria-busy="true"
>
  <header class="simulation-header">
    <div>
      <h2 id="network-simulation-title">PFC–CA3–CA1 spike activity</h2>
    </div>
    <p class="load-status" data-load-status>Loading simulation…</p>
  </header>

  <div class="view-heading">
    <span data-view-label>View</span>
    <div>
      <h3 data-layout-title>Interspersed neuron view</h3>
      <p data-layout-description hidden></p>
    </div>
  </div>
  <div class="canvas-shell">
    <canvas
      width="1000"
      height="540"
      data-network-canvas
      role="img"
      aria-label="Selectable animated spike activity across 3,450 PFC, CA3, and CA1 neurons, with an alternate population activity and spike raster view"
      tabindex="0"
    >
      This visualization requires a browser with Canvas support.
    </canvas>
    <div class="canvas-key" data-canvas-key aria-hidden="true">
      <span><i class="filled"></i>Pyramidal</span>
      <span><i class="ring"></i>Interneuron</span>
      <span><i class="bright"></i>Recent spike</span>
    </div>
    <section class="connectivity-overlay" data-connectivity-block hidden aria-labelledby="connectivity-title">
      <div class="connectivity-overlay__heading">
        <div><span id="connectivity-title">Selected-neuron connections</span><strong data-connectivity-status>Checking connectivity…</strong></div>
      </div>
      <fieldset class="connectivity-controls" data-connectivity-controls disabled>
        <label>Direction<select data-connectivity-direction><option value="incoming">Incoming</option><option value="outgoing">Outgoing</option><option value="both">Both</option></select></label>
        <label>Projection<select data-connectivity-projection><option value="">All relevant</option></select></label>
        <label>Type<select data-connectivity-type><option value="">Excitatory + inhibitory</option><option value="excitatory">Excitatory</option><option value="inhibitory">Inhibitory</option></select></label>
        <label>Strongest edges<select data-connectivity-limit><option value="50">50</option><option value="100">100</option><option value="200" selected>200</option></select></label>
      </fieldset>
      <p class="connectivity-note" data-connectivity-note></p>
    </section>
  </div>

  <section class="signal-panel" data-signal-panel hidden aria-labelledby="current-panel-title">
    <header class="signal-header">
      <div>
        <h3 id="current-panel-title">CA1 somatic-current proxy</h3>
      </div>
      <label class="window-control">
        <span>Window</span>
        <select data-trace-window disabled>
          <option value="500">0.5 s</option>
          <option value="1000">1 s</option>
          <option value="2000" selected>2 s</option>
          <option value="5000">5 s</option>
        </select>
      </label>
    </header>
    <canvas
      class="current-canvas"
      width="1000"
      height="330"
      data-current-canvas
      role="img"
      aria-label="Summed CA1 somatic model current, an LFP-like proxy rather than a measured LFP or membrane voltage"
    ></canvas>
    <section class="rate-panel" data-rate-panel hidden aria-labelledby="rate-panel-title">
      <header class="rate-header">
        <div>
          <p class="eyebrow">Population activity</p>
          <h3 id="rate-panel-title">Smoothed firing rates</h3>
          <p>Six population rates in spikes per neuron per second. Solid traces are pyramidal; dashed traces are interneurons.</p>
        </div>
        <button type="button" data-rate-toggle aria-expanded="true">Collapse rates</button>
      </header>
      <canvas
        class="rate-canvas"
        width="1000"
        height="360"
        data-rate-canvas
        role="img"
        aria-label="Six synchronized population firing-rate traces for PFC, CA3, and CA1 pyramidal neurons and interneurons"
      ></canvas>
    </section>
    <div class="overview-heading">
      <span>30-second overview</span>
      <span>Shaded bars mark detected SPW-Rs</span>
    </div>
    <canvas
      class="overview-canvas"
      width="1000"
      height="68"
      data-overview-canvas
      role="img"
      aria-label="Full simulation overview with the visible trace window, playhead, and detected SPW-R locations"
      tabindex="0"
    ></canvas>
    <div class="event-controls" aria-label="SPW-R event navigation">
      <button type="button" data-previous-event disabled>Previous event</button>
      <button type="button" data-focus-event disabled>Focus event</button>
      <button type="button" data-next-event disabled>Next event</button>
      <output data-event-details aria-live="polite">No event selected</output>
    </div>
  </section>

  <section class="neuron-inspector" data-neuron-inspector hidden aria-hidden="true" aria-labelledby="neuron-inspector-title">
    <header class="inspector-header">
      <div>
        <p class="eyebrow">Neuron inspection</p>
        <h3 id="neuron-inspector-title" data-inspector-title>Select a neuron</h3>
        <p data-inspector-summary>Choose a neuron in either network layout to inspect its identity and spike history.</p>
      </div>
    </header>
    <div class="inspector-content" data-inspector-content hidden>
      <dl class="neuron-metadata">
        <div><dt>Global ID</dt><dd data-neuron-id>—</dd></div>
        <div><dt>Region</dt><dd data-neuron-region>—</dd></div>
        <div><dt>Cell type</dt><dd data-neuron-cell-type>—</dd></div>
        <div><dt>Population-local ID</dt><dd data-neuron-local-id>—</dd></div>
        <div><dt>Spike count</dt><dd data-neuron-spike-count>—</dd></div>
      </dl>
      <div class="history-block">
        <div class="history-heading"><span>Full 30-second spike history</span><span data-spike-history-label></span></div>
        <canvas class="spike-history-canvas" width="1000" height="66" data-spike-history-canvas role="img" aria-label="Full-recording spike history for the selected neuron"></canvas>
      </div>
      <div class="history-block">
        <div class="history-heading"><span>Spikes in active window</span><span data-window-spike-label></span></div>
        <canvas class="window-spike-canvas" width="1000" height="104" data-window-spike-canvas role="img" aria-label="Expanded spike history in the current rolling window"></canvas>
      </div>
      <div class="voltage-block" data-voltage-block>
        <div class="history-heading"><span>Membrane voltage</span><span data-voltage-status>Checking recording availability…</span></div>
        <canvas class="voltage-canvas" width="1000" height="150" data-voltage-canvas role="img" aria-label="Membrane voltage for the selected recorded neuron" hidden></canvas>
        <p class="voltage-unavailable" data-voltage-unavailable hidden></p>
      </div>
    </div>
  </section>

  <div class="playback-controls" aria-label="Simulation playback controls">
    <button type="button" class="play-button" data-play disabled>Play</button>
    <button type="button" class="restart-button" data-restart disabled>Restart</button>
    <button type="button" class="view-button" data-view-toggle disabled>View: neurons</button>
    <button
      type="button"
      class="layout-button"
      data-layout-toggle
      aria-pressed="true"
      disabled
    >Layout: interspersed</button>
    <output data-time aria-label="Current simulation time">0.000 s / 30.000 s</output>
    <label class="speed-control">
      <span>Speed</span>
      <select data-speed disabled>
        <option value="0.25">0.25×</option>
        <option value="0.5" selected>0.5×</option>
        <option value="1">1×</option>
        <option value="2">2×</option>
        <option value="4">4×</option>
      </select>
    </label>
  </div>

  <label class="timeline-label" for="network-timeline">Simulation time</label>
  <input
    id="network-timeline"
    class="timeline"
    data-timeline
    type="range"
    min="0"
    max="30000"
    step="1"
    value="0"
    disabled
  />

  <fieldset class="population-controls" disabled data-population-controls>
    <legend>Visible populations</legend>
    <div>
      {populations.map((population) => (
        <label style={`--population-color:${population.color}`}>
          <input type="checkbox" checked value={population.id} data-population-toggle />
          <span>{population.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <p class="simulation-note" data-simulation-note hidden></p>
  <p class="simulation-warning" data-optional-warning hidden></p>
  <p class="simulation-error" data-error hidden></p>
  <noscript><p class="simulation-error">JavaScript is required to replay the simulation.</p></noscript>
</section>

<script>
  import {
    lowerBound,
    parseSignalDataset,
    parseConnectivityDataset,
    parseSpikeDataset,
    validateEventsDocument,
    validateManifest,
    type SignalDataset,
    type SignalGroupDescriptor,
    type PopulationDescriptor,
    type SimulationManifest,
    type SimulationManifestV2,
    type SpikeDataset,
    type SpwrEvent,
    type VoltageGroupDescriptor,
    type ConnectivityDescriptor,
  } from '../../../lib/network-data';
  import {
    computeFixedDomains,
    downsampleMinMax,
    focusPlaybackRange,
    getRollingWindow,
    nextEventIndex,
    previousEventIndex,
    type SignalDomain,
  } from '../../../lib/signal-viewer';
  import {
    collectNeuronSpikeTimes,
    computeRateDomains,
    countSpikesByNeuron,
    findVoltageChannel,
    identifyNeuron,
    nearestNeuronId,
  } from '../../../lib/neuron-inspector';
  import {
    projectionAppliesToSelection,
    selectConnections,
    transmissionPulseProgress,
    type ConnectivityDirection,
    type DisplayedConnection,
    type LoadedProjection,
  } from '../../../lib/connectivity-viewer';

  const REGION_COLORS: Record<string, string> = {
    PFC: '#8f948d',
    CA3: '#b9bdb7',
    CA1: '#e5e7e2',
  };
  const REGIONS = ['PFC', 'CA3', 'CA1'] as const;
  const DECAY_MS = 120;
  const ACTIVE_WINDOW_MS = 500;

  document.querySelectorAll<HTMLElement>('[data-network-simulation]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-network-canvas]')!;
    const playButton = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const restartButton = root.querySelector<HTMLButtonElement>('[data-restart]')!;
    const viewButton = root.querySelector<HTMLButtonElement>('[data-view-toggle]')!;
    const layoutButton = root.querySelector<HTMLButtonElement>('[data-layout-toggle]')!;
    const viewLabel = root.querySelector<HTMLElement>('[data-view-label]')!;
    const layoutTitle = root.querySelector<HTMLElement>('[data-layout-title]')!;
    const layoutDescription = root.querySelector<HTMLElement>('[data-layout-description]')!;
    const canvasKey = root.querySelector<HTMLElement>('[data-canvas-key]')!;
    const simulationNote = root.querySelector<HTMLElement>('[data-simulation-note]')!;
    const timeline = root.querySelector<HTMLInputElement>('[data-timeline]')!;
    const speedSelect = root.querySelector<HTMLSelectElement>('[data-speed]')!;
    const timeOutput = root.querySelector<HTMLOutputElement>('[data-time]')!;
    const loadStatus = root.querySelector<HTMLElement>('[data-load-status]')!;
    const errorOutput = root.querySelector<HTMLElement>('[data-error]')!;
    const populationControls = root.querySelector<HTMLFieldSetElement>('[data-population-controls]')!;
    const toggles = [...root.querySelectorAll<HTMLInputElement>('[data-population-toggle]')];
    const signalPanel = root.querySelector<HTMLElement>('[data-signal-panel]')!;
    const currentCanvas = root.querySelector<HTMLCanvasElement>('[data-current-canvas]')!;
    const overviewCanvas = root.querySelector<HTMLCanvasElement>('[data-overview-canvas]')!;
    const traceWindowSelect = root.querySelector<HTMLSelectElement>('[data-trace-window]')!;
    const previousEventButton = root.querySelector<HTMLButtonElement>('[data-previous-event]')!;
    const nextEventButton = root.querySelector<HTMLButtonElement>('[data-next-event]')!;
    const focusEventButton = root.querySelector<HTMLButtonElement>('[data-focus-event]')!;
    const eventDetails = root.querySelector<HTMLOutputElement>('[data-event-details]')!;
    const optionalWarning = root.querySelector<HTMLElement>('[data-optional-warning]')!;
    const rateCanvas = root.querySelector<HTMLCanvasElement>('[data-rate-canvas]')!;
    const rateToggle = root.querySelector<HTMLButtonElement>('[data-rate-toggle]')!;
    const inspector = root.querySelector<HTMLElement>('[data-neuron-inspector]')!;
    const inspectorTitle = root.querySelector<HTMLElement>('[data-inspector-title]')!;
    const inspectorSummary = root.querySelector<HTMLElement>('[data-inspector-summary]')!;
    const inspectorContent = root.querySelector<HTMLElement>('[data-inspector-content]')!;
    const neuronIdOutput = root.querySelector<HTMLElement>('[data-neuron-id]')!;
    const neuronRegionOutput = root.querySelector<HTMLElement>('[data-neuron-region]')!;
    const neuronCellTypeOutput = root.querySelector<HTMLElement>('[data-neuron-cell-type]')!;
    const neuronLocalIdOutput = root.querySelector<HTMLElement>('[data-neuron-local-id]')!;
    const neuronSpikeCountOutput = root.querySelector<HTMLElement>('[data-neuron-spike-count]')!;
    const spikeHistoryLabel = root.querySelector<HTMLElement>('[data-spike-history-label]')!;
    const windowSpikeLabel = root.querySelector<HTMLElement>('[data-window-spike-label]')!;
    const spikeHistoryCanvas = root.querySelector<HTMLCanvasElement>('[data-spike-history-canvas]')!;
    const windowSpikeCanvas = root.querySelector<HTMLCanvasElement>('[data-window-spike-canvas]')!;
    const voltageCanvas = root.querySelector<HTMLCanvasElement>('[data-voltage-canvas]')!;
    const voltageStatus = root.querySelector<HTMLElement>('[data-voltage-status]')!;
    const voltageUnavailable = root.querySelector<HTMLElement>('[data-voltage-unavailable]')!;
    const connectivityBlock = root.querySelector<HTMLElement>('[data-connectivity-block]')!;
    const connectivityStatus = root.querySelector<HTMLElement>('[data-connectivity-status]')!;
    const connectivityNote = root.querySelector<HTMLElement>('[data-connectivity-note]')!;
    const connectivityControls = root.querySelector<HTMLFieldSetElement>('[data-connectivity-controls]')!;
    const connectivityDirection = root.querySelector<HTMLSelectElement>('[data-connectivity-direction]')!;
    const connectivityProjection = root.querySelector<HTMLSelectElement>('[data-connectivity-projection]')!;
    const connectivityType = root.querySelector<HTMLSelectElement>('[data-connectivity-type]')!;
    const connectivityLimit = root.querySelector<HTMLSelectElement>('[data-connectivity-limit]')!;

    const maybeContext = canvas.getContext('2d');
    if (!maybeContext) {
      showError('Canvas rendering is not available in this browser.');
      return;
    }
    const context = maybeContext;
    const currentContext = currentCanvas.getContext('2d');
    const overviewContext = overviewCanvas.getContext('2d');
    const rateContext = rateCanvas.getContext('2d');
    const spikeHistoryContext = spikeHistoryCanvas.getContext('2d');
    const windowSpikeContext = windowSpikeCanvas.getContext('2d');
    const voltageContext = voltageCanvas.getContext('2d');

    let manifest: SimulationManifest;
    let spikes: SpikeDataset;
    let currentDescriptor: SignalGroupDescriptor | undefined;
    let currents: SignalDataset | undefined;
    let currentDomains: SignalDomain[] = [];
    let rateDescriptor: SignalGroupDescriptor | undefined;
    let rates: SignalDataset | undefined;
    let rateDomains: SignalDomain[] = [];
    let ratesExpanded = false;
    let events: SpwrEvent[] = [];
    let selectedEventIndex = -1;
    let traceWindowMs = 2_000;
    let focusActive = false;
    let focusEndMs = 0;
    let focusPreviousSpeed = 0.5;
    let currentMs = 0;
    let eventCursor = 0;
    let playing = false;
    let speed = 0.5;
    let networkView: 'neurons' | 'activity' = 'neurons';
    let layoutMix = 1;
    let layoutTarget = 1;
    let layoutAnimationRequest = 0;
    let focusMix = 0;
    let focusAnimationRequest = 0;
    let frameRequest = 0;
    let anchorRealMs = 0;
    let anchorSimulationMs = 0;
    let lastSpikeTicks = new Int32Array();
    let xPositions = new Float32Array();
    let yPositions = new Float32Array();
    let interspersedXPositions = new Float32Array();
    let interspersedYPositions = new Float32Array();
    let populationByNeuron = new Uint8Array();
    let visiblePopulations: boolean[] = [];
    let backgroundCanvas = document.createElement('canvas');
    let cssWidth = 1000;
    let cssHeight = 540;
    let layoutLabelWidth = 76;
    let layoutTopPadding = 19;
    let layoutGap = 16;
    let layoutBandHeight = 0;
    let signalCssWidth = 1000;
    let overviewBackground = document.createElement('canvas');
    let manifestBaseUrl = '';
    let voltageGroups: VoltageGroupDescriptor[] = [];
    let connectivityDescriptor: ConnectivityDescriptor | undefined;
    const connectivityCache = new Map<string, Promise<LoadedProjection>>();
    let loadedConnectivity: LoadedProjection[] = [];
    let displayedConnections: DisplayedConnection[] = [];
    let focusedPositions = new Map<number, { x: number; y: number }>();
    let connectivityRequest = 0;
    const voltageCache = new Map<string, Promise<SignalDataset>>();
    let selectedNeuronId = -1;
    let selectedSpikeTimes: Float32Array = new Float32Array();
    let spikeCounts: Uint32Array = new Uint32Array();
    let selectedVoltageDescriptor: VoltageGroupDescriptor | undefined;
    let selectedVoltageChannel = -1;
    let selectedVoltageDataset: SignalDataset | undefined;
    let selectionRequest = 0;
    let inspectorCssWidth = 1000;

    function showError(message: string) {
      root.setAttribute('aria-busy', 'false');
      loadStatus.textContent = 'Unable to load';
      errorOutput.textContent = message;
      errorOutput.hidden = false;
    }

    function showOptionalWarning(message: string) {
      optionalWarning.textContent = message;
      optionalWarning.hidden = false;
    }

    function formatTime(milliseconds: number) {
      return `${(milliseconds / 1000).toFixed(3)} s / ${(manifest.durationMs / 1000).toFixed(3)} s`;
    }

    function formatAxisValue(value: number) {
      const magnitude = Math.abs(value);
      if (magnitude >= 10_000) return `${(value / 1_000).toFixed(0)}k`;
      if (magnitude >= 1_000) return `${(value / 1_000).toFixed(1)}k`;
      if (magnitude >= 10) return value.toFixed(0);
      return value.toFixed(1);
    }

    function hexToRgba(hex: string, alpha: number) {
      const value = Number.parseInt(hex.slice(1), 16);
      return `rgba(${value >> 16}, ${(value >> 8) & 255}, ${value & 255}, ${alpha})`;
    }

    function traceNeuronShape(
      target: CanvasRenderingContext2D,
      x: number,
      y: number,
      radius: number,
      cellType: PopulationDescriptor['cellType'],
    ) {
      target.beginPath();
      if (cellType === 'pyramidal') {
        target.moveTo(x, y - radius);
        target.lineTo(x + radius * 0.9, y + radius * 0.62);
        target.lineTo(x - radius * 0.9, y + radius * 0.62);
        target.closePath();
      } else {
        target.arc(x, y, radius, 0, Math.PI * 2);
      }
    }

    function placeGrid(population: PopulationDescriptor, populationIndex: number, x: number, y: number, width: number, height: number) {
      const columns = Math.max(1, Math.ceil(Math.sqrt(population.count * (width / height))));
      const rows = Math.ceil(population.count / columns);
      const spacingX = width / Math.max(columns - 1, 1);
      const spacingY = height / Math.max(rows - 1, 1);
      for (let localId = 0; localId < population.count; localId += 1) {
        const globalId = population.idStart + localId;
        const column = localId % columns;
        const row = Math.floor(localId / columns);
        const stagger = row % 2 === 0 ? 0 : Math.min(spacingX * 0.35, 2.5);
        xPositions[globalId] = Math.min(x + width, x + column * spacingX + stagger);
        yPositions[globalId] = y + row * spacingY;
        populationByNeuron[globalId] = populationIndex;
      }
    }

    function placeInterspersedPopulation(
      population: PopulationDescriptor,
      x: number,
      y: number,
      width: number,
      height: number,
    ) {
      const interneuronCount = population.region === 'PFC' ? 250 : 100;
      const combinedCount = population.region === 'PFC' ? 1250 : 1100;
      const interval = combinedCount / interneuronCount;
      const columns = Math.max(1, Math.ceil(Math.sqrt(combinedCount * (width / height))));
      const rows = Math.ceil(combinedCount / columns);
      const spacingX = width / Math.max(columns - 1, 1);
      const spacingY = height / Math.max(rows - 1, 1);
      for (let localId = 0; localId < population.count; localId += 1) {
        const globalId = population.idStart + localId;
        const combinedIndex = population.cellType === 'interneuron'
          ? interval * (localId + 1) - 1
          : localId + Math.floor(localId / (interval - 1));
        const column = combinedIndex % columns;
        const row = Math.floor(combinedIndex / columns);
        const stagger = row % 2 === 0 ? 0 : Math.min(spacingX * 0.35, 2.5);
        interspersedXPositions[globalId] = Math.min(x + width, x + column * spacingX + stagger);
        interspersedYPositions[globalId] = y + row * spacingY;
      }
    }

    function rebuildLayout() {
      const rect = canvas.getBoundingClientRect();
      cssWidth = Math.max(280, rect.width);
      cssHeight = Math.max(400, rect.height);
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(cssWidth * pixelRatio);
      canvas.height = Math.round(cssHeight * pixelRatio);
      backgroundCanvas.width = canvas.width;
      backgroundCanvas.height = canvas.height;
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

      xPositions = new Float32Array(manifest.neuronCount);
      yPositions = new Float32Array(manifest.neuronCount);
      interspersedXPositions = new Float32Array(manifest.neuronCount);
      interspersedYPositions = new Float32Array(manifest.neuronCount);
      populationByNeuron = new Uint8Array(manifest.neuronCount);
      const labelWidth = cssWidth < 520 ? 58 : 76;
      const rightPadding = cssWidth < 520 ? 14 : 28;
      const topPadding = 19;
      const gap = 16;
      const bandHeight = (cssHeight - topPadding * 2 - gap * 2) / 3;
      layoutLabelWidth = labelWidth;
      layoutTopPadding = topPadding;
      layoutGap = gap;
      layoutBandHeight = bandHeight;

      manifest.populations.forEach((population, populationIndex) => {
        const regionIndex = REGIONS.indexOf(population.region);
        const bandTop = topPadding + regionIndex * (bandHeight + gap);
        const gridX = labelWidth + 12;
        const gridWidth = cssWidth - gridX - rightPadding;
        if (population.cellType === 'pyramidal') {
          placeGrid(population, populationIndex, gridX, bandTop + 18, gridWidth, bandHeight * 0.58);
        } else {
          placeGrid(population, populationIndex, gridX, bandTop + bandHeight * 0.78, gridWidth, Math.max(6, bandHeight * 0.08));
        }
      });

      manifest.populations.forEach((population) => {
        const regionIndex = REGIONS.indexOf(population.region);
        const bandTop = topPadding + regionIndex * (bandHeight + gap);
        placeInterspersedPopulation(
          population,
          labelWidth + 12,
          bandTop + 18,
          cssWidth - labelWidth - rightPadding - 12,
          bandHeight * 0.68,
        );
      });

      drawBackground(pixelRatio, labelWidth, topPadding, gap, bandHeight);
      render();
    }

    function neuronX(neuronId: number) {
      return xPositions[neuronId] + (interspersedXPositions[neuronId] - xPositions[neuronId]) * layoutMix;
    }

    function neuronY(neuronId: number) {
      return yPositions[neuronId] + (interspersedYPositions[neuronId] - yPositions[neuronId]) * layoutMix;
    }

    function drawBackground(pixelRatio: number, labelWidth: number, topPadding: number, gap: number, bandHeight: number) {
      const bg = backgroundCanvas.getContext('2d');
      if (!bg) return;
      bg.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      bg.clearRect(0, 0, cssWidth, cssHeight);
      bg.fillStyle = '#101210';
      bg.fillRect(0, 0, cssWidth, cssHeight);

      REGIONS.forEach((region, regionIndex) => {
        const bandTop = topPadding + regionIndex * (bandHeight + gap);
        const combinedCount = region === 'PFC' ? 1250 : 1100;
        const emphasized = region === 'CA1';
        if (emphasized) {
          bg.fillStyle = 'rgba(238, 240, 235, .025)';
          bg.fillRect(0, bandTop, cssWidth, bandHeight);
          bg.fillStyle = '#eef0eb';
          bg.fillRect(labelWidth - 2, bandTop, 2, bandHeight);
        }
        bg.fillStyle = emphasized ? '#ffffff' : '#c5c8c2';
        bg.font = '11px Arial, sans-serif';
        bg.textAlign = 'left';
        bg.textBaseline = 'top';
        bg.fillText(region, 14, bandTop + 18);
        bg.fillStyle = emphasized ? '#e1e3de' : '#cfd2cc';
        bg.font = '9px Arial, sans-serif';
        if (layoutMix >= 0.5) {
          bg.fillText(`${combinedCount.toLocaleString()} mixed`, 14, bandTop + 34);
        } else {
          bg.fillText('PY', 14, bandTop + 34);
          bg.fillText('IN', 14, bandTop + bandHeight * 0.76);
        }
        if (regionIndex < REGIONS.length - 1) {
          bg.strokeStyle = '#282b27';
          bg.lineWidth = 1;
          bg.beginPath();
          bg.moveTo(labelWidth, bandTop + bandHeight + gap / 2);
          bg.lineTo(cssWidth - 14, bandTop + bandHeight + gap / 2);
          bg.stroke();
        }
      });

      manifest.populations.forEach((population, populationIndex) => {
        if (!visiblePopulations[populationIndex]) return;
        const color = REGION_COLORS[population.region];
        if (population.cellType === 'pyramidal') {
          bg.fillStyle = hexToRgba(color, 0.28);
          for (let local = 0; local < population.count; local += 1) {
            const id = population.idStart + local;
            const radius = cssWidth < 520 ? 1.05 : 1.4;
            traceNeuronShape(bg, neuronX(id), neuronY(id), radius, population.cellType);
            bg.fill();
          }
        } else {
          bg.strokeStyle = hexToRgba(color, 0.48);
          bg.lineWidth = 0.8;
          for (let local = 0; local < population.count; local += 1) {
            const id = population.idStart + local;
            bg.beginPath();
            bg.arc(neuronX(id), neuronY(id), cssWidth < 520 ? 1.15 : 1.4, 0, Math.PI * 2);
            bg.stroke();
          }
        }
      });
    }

    function yForValue(value: number, domain: SignalDomain, top: number, height: number) {
      return top + height - ((value - domain.min) / (domain.max - domain.min)) * height;
    }

    function rebuildSignalCanvases() {
      if (!currents || !currentContext || !overviewContext) return;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      signalCssWidth = Math.max(280, currentCanvas.getBoundingClientRect().width);
      const currentHeight = signalCssWidth < 520 ? 190 : 160;
      const overviewHeight = 68;
      currentCanvas.width = Math.round(signalCssWidth * pixelRatio);
      currentCanvas.height = Math.round(currentHeight * pixelRatio);
      currentCanvas.style.height = `${currentHeight}px`;
      overviewCanvas.width = Math.round(signalCssWidth * pixelRatio);
      overviewCanvas.height = Math.round(overviewHeight * pixelRatio);
      overviewCanvas.style.height = `${overviewHeight}px`;
      overviewBackground.width = overviewCanvas.width;
      overviewBackground.height = overviewCanvas.height;
      drawOverviewBackground(pixelRatio, overviewHeight);
      renderSignalViews();
    }

    function drawOverviewBackground(pixelRatio: number, height: number) {
      if (!currents || !currentDescriptor) return;
      const target = overviewBackground.getContext('2d');
      if (!target) return;
      const left = 10;
      const right = 10;
      const top = 10;
      const plotWidth = Math.max(1, Math.floor(signalCssWidth - left - right));
      const plotHeight = height - top - 12;
      target.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      target.clearRect(0, 0, signalCssWidth, height);
      target.fillStyle = '#0f110f';
      target.fillRect(0, 0, signalCssWidth, height);

      target.fillStyle = 'rgba(207, 211, 205, .18)';
      for (const event of events) {
        const x = left + event.startMs / manifest.durationMs * plotWidth;
        const width = Math.max(1.5, (event.endMs - event.startMs) / manifest.durationMs * plotWidth);
        target.fillRect(x, top, width, plotHeight);
      }

      const envelope = downsampleMinMax(currents, 0, currentDescriptor.sampleRateHz, 0, manifest.durationMs, plotWidth);
      const domain = currentDomains[0];
      target.strokeStyle = 'rgba(207, 211, 205, .72)';
      target.lineWidth = 1;
      target.beginPath();
      for (let pixel = 0; pixel < plotWidth; pixel += 1) {
        const x = left + pixel + 0.5;
        target.moveTo(x, yForValue(envelope.minimums[pixel], domain, top, plotHeight));
        target.lineTo(x, yForValue(envelope.maximums[pixel], domain, top, plotHeight));
      }
      target.stroke();
      target.strokeStyle = '#343733';
      target.strokeRect(left + 0.5, top + 0.5, plotWidth - 1, plotHeight - 1);
    }

    function renderSignalViews() {
      if (!currents || !currentDescriptor || !currentContext || !overviewContext) return;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      const width = signalCssWidth;
      const height = currentCanvas.height / pixelRatio;
      const mobile = width < 520;
      const left = mobile ? 74 : 108;
      const right = 16;
      const top = 14;
      const bandHeight = height - top * 2 - 8;
      const plotWidth = Math.max(1, Math.floor(width - left - right));
      const visible = getRollingWindow(currentMs, manifest.durationMs, traceWindowMs);
      const color = '#cfd3cd';

      currentContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      currentContext.clearRect(0, 0, width, height);
      currentContext.fillStyle = '#0f110f';
      currentContext.fillRect(0, 0, width, height);

      for (let channel = 0; channel < 1; channel += 1) {
        const bandTop = top;
        const domain = currentDomains[channel];
        currentContext.fillStyle = channel % 2 === 0 ? '#111310' : '#10120f';
        currentContext.fillRect(left, bandTop, plotWidth, bandHeight);

        if (channel === 0) {
          for (let index = 0; index < events.length; index += 1) {
            const event = events[index];
            if (event.endMs < visible.startMs || event.startMs > visible.endMs) continue;
            const x = left + (event.startMs - visible.startMs) / (visible.endMs - visible.startMs) * plotWidth;
            const eventWidth = Math.max(2, (event.endMs - event.startMs) / (visible.endMs - visible.startMs) * plotWidth);
            currentContext.fillStyle = index === selectedEventIndex ? 'rgba(207, 211, 205, .24)' : 'rgba(207, 211, 205, .1)';
            currentContext.fillRect(x, bandTop, eventWidth, bandHeight);
          }
        }

        if (domain.min < 0 && domain.max > 0) {
          const zeroY = yForValue(0, domain, bandTop, bandHeight);
          currentContext.strokeStyle = '#292c28';
          currentContext.lineWidth = 1;
          currentContext.beginPath();
          currentContext.moveTo(left, zeroY + 0.5);
          currentContext.lineTo(left + plotWidth, zeroY + 0.5);
          currentContext.stroke();
        }

        const envelope = downsampleMinMax(
          currents,
          channel,
          currentDescriptor.sampleRateHz,
          visible.startMs,
          visible.endMs,
          plotWidth,
        );
        currentContext.strokeStyle = color;
        currentContext.lineWidth = 1;
        currentContext.beginPath();
        for (let pixel = 0; pixel < plotWidth; pixel += 1) {
          const x = left + pixel + 0.5;
          currentContext.moveTo(x, yForValue(envelope.minimums[pixel], domain, bandTop, bandHeight));
          currentContext.lineTo(x, yForValue(envelope.maximums[pixel], domain, bandTop, bandHeight));
        }
        currentContext.stroke();

        const playheadX = left + (currentMs - visible.startMs) / (visible.endMs - visible.startMs) * plotWidth;
        currentContext.strokeStyle = 'rgba(235, 237, 230, .72)';
        currentContext.lineWidth = 1;
        currentContext.beginPath();
        currentContext.moveTo(playheadX + 0.5, bandTop);
        currentContext.lineTo(playheadX + 0.5, bandTop + bandHeight);
        currentContext.stroke();

        const metadata = currentDescriptor.channels[channel];
        currentContext.fillStyle = color;
        currentContext.font = `${mobile ? 9 : 10}px Arial, sans-serif`;
        currentContext.textAlign = 'left';
        currentContext.textBaseline = 'top';
        const words = metadata.label.split(' ');
        if (mobile && words.length > 2) {
          currentContext.fillText(words.slice(0, 2).join(' '), 8, bandTop + 3);
          currentContext.fillText(words.slice(2).join(' '), 8, bandTop + 16);
        } else {
          currentContext.fillText(metadata.label, 8, bandTop + 3);
        }
        currentContext.fillStyle = '#cfd2cc';
        currentContext.font = '9px Arial, sans-serif';
        currentContext.fillText(formatAxisValue(domain.max), 8, bandTop + bandHeight - 24);
        currentContext.fillText(formatAxisValue(domain.min), 8, bandTop + bandHeight - 12);
        currentContext.strokeStyle = '#343733';
        currentContext.strokeRect(left + 0.5, bandTop + 0.5, plotWidth - 1, bandHeight - 1);
      }

      currentContext.fillStyle = '#cfd2cc';
      currentContext.font = '9px Arial, sans-serif';
      currentContext.textBaseline = 'bottom';
      currentContext.textAlign = 'left';
      currentContext.fillText(`${(visible.startMs / 1_000).toFixed(2)} s`, left, height - 3);
      currentContext.textAlign = 'right';
      currentContext.fillText(`${(visible.endMs / 1_000).toFixed(2)} s`, left + plotWidth, height - 3);

      const overviewHeight = overviewCanvas.height / pixelRatio;
      overviewContext.setTransform(1, 0, 0, 1, 0, 0);
      overviewContext.clearRect(0, 0, overviewCanvas.width, overviewCanvas.height);
      overviewContext.drawImage(overviewBackground, 0, 0);
      overviewContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      const overviewLeft = 10;
      const overviewWidth = width - 20;
      const overviewTop = 10;
      const overviewPlotHeight = overviewHeight - 22;
      const windowX = overviewLeft + visible.startMs / manifest.durationMs * overviewWidth;
      const windowWidth = Math.max(2, (visible.endMs - visible.startMs) / manifest.durationMs * overviewWidth);
      overviewContext.fillStyle = 'rgba(235, 237, 230, .08)';
      overviewContext.fillRect(windowX, overviewTop, windowWidth, overviewPlotHeight);
      overviewContext.strokeStyle = 'rgba(235, 237, 230, .45)';
      overviewContext.strokeRect(windowX + 0.5, overviewTop + 0.5, Math.max(1, windowWidth - 1), overviewPlotHeight - 1);
      const overviewPlayheadX = overviewLeft + currentMs / manifest.durationMs * overviewWidth;
      overviewContext.strokeStyle = '#eef0e9';
      overviewContext.beginPath();
      overviewContext.moveTo(overviewPlayheadX + 0.5, overviewTop - 3);
      overviewContext.lineTo(overviewPlayheadX + 0.5, overviewTop + overviewPlotHeight + 3);
      overviewContext.stroke();
    }

    function rebuildRateCanvas() {
      if (!rates || !rateContext || !ratesExpanded) return;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      const width = Math.max(280, rateCanvas.getBoundingClientRect().width);
      const height = width < 520 ? 430 : 360;
      rateCanvas.width = Math.round(width * pixelRatio);
      rateCanvas.height = Math.round(height * pixelRatio);
      rateCanvas.style.height = `${height}px`;
      renderRateViews();
    }

    function renderRateViews() {
      if (!rates || !rateDescriptor || !rateContext || !ratesExpanded) return;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      const width = rateCanvas.width / pixelRatio;
      const height = rateCanvas.height / pixelRatio;
      const mobile = width < 520;
      const left = mobile ? 92 : 138;
      const right = 14;
      const top = 12;
      const gap = 6;
      const bandHeight = (height - top * 2 - gap * 5) / 6;
      const plotWidth = Math.max(1, Math.floor(width - left - right));
      const visible = getRollingWindow(currentMs, manifest.durationMs, traceWindowMs);

      rateContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      rateContext.clearRect(0, 0, width, height);
      rateContext.fillStyle = '#0f110f';
      rateContext.fillRect(0, 0, width, height);

      for (let channel = 0; channel < rates.channelCount; channel += 1) {
        const bandTop = top + channel * (bandHeight + gap);
        const metadata = rateDescriptor.channels[channel];
        const population = manifest.populations.find((entry) => entry.id === metadata.id);
        const color = population ? REGION_COLORS[population.region] : '#c7c9c2';
        const domain = rateDomains[channel];
        rateContext.fillStyle = channel % 2 === 0 ? '#111310' : '#10120f';
        rateContext.fillRect(left, bandTop, plotWidth, bandHeight);

        const envelope = downsampleMinMax(
          rates,
          channel,
          rateDescriptor.sampleRateHz,
          visible.startMs,
          visible.endMs,
          plotWidth,
        );
        rateContext.strokeStyle = color;
        rateContext.lineWidth = population?.cellType === 'interneuron' ? 1.25 : 1;
        rateContext.setLineDash(population?.cellType === 'interneuron' ? [4, 3] : []);
        rateContext.beginPath();
        for (let pixel = 0; pixel < plotWidth; pixel += 1) {
          const x = left + pixel + 0.5;
          const value = (envelope.minimums[pixel] + envelope.maximums[pixel]) / 2;
          const y = yForValue(value, domain, bandTop, bandHeight);
          if (pixel === 0) rateContext.moveTo(x, y);
          else rateContext.lineTo(x, y);
        }
        rateContext.stroke();
        rateContext.setLineDash([]);

        const playheadX = left + (currentMs - visible.startMs) / (visible.endMs - visible.startMs) * plotWidth;
        rateContext.strokeStyle = 'rgba(235, 237, 230, .68)';
        rateContext.beginPath();
        rateContext.moveTo(playheadX + 0.5, bandTop);
        rateContext.lineTo(playheadX + 0.5, bandTop + bandHeight);
        rateContext.stroke();

        rateContext.fillStyle = color;
        rateContext.font = `${mobile ? 8 : 9}px Arial, sans-serif`;
        rateContext.textAlign = 'left';
        rateContext.textBaseline = 'top';
        rateContext.fillText(metadata.label, 8, bandTop + 3);
        rateContext.fillStyle = '#cfd2cc';
        rateContext.font = '9px Arial, sans-serif';
        rateContext.fillText(formatAxisValue(domain.max), 8, bandTop + bandHeight - 11);
        rateContext.strokeStyle = '#343733';
        rateContext.strokeRect(left + 0.5, bandTop + 0.5, plotWidth - 1, bandHeight - 1);
      }
    }

    function prepareInspectorCanvases() {
      if (selectedNeuronId < 0) return;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      inspectorCssWidth = Math.max(280, spikeHistoryCanvas.getBoundingClientRect().width);
      const sizes: Array<[HTMLCanvasElement, number]> = [
        [spikeHistoryCanvas, 66],
        [windowSpikeCanvas, 104],
        [voltageCanvas, inspectorCssWidth < 520 ? 178 : 150],
      ];
      for (const [target, height] of sizes) {
        target.width = Math.round(inspectorCssWidth * pixelRatio);
        target.height = Math.round(height * pixelRatio);
        target.style.height = `${height}px`;
      }
      renderInspector();
    }

    function drawSpikeRaster(
      target: CanvasRenderingContext2D,
      targetCanvas: HTMLCanvasElement,
      startMs: number,
      endMs: number,
      expanded: boolean,
    ) {
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      const width = targetCanvas.width / pixelRatio;
      const height = targetCanvas.height / pixelRatio;
      const left = 12;
      const right = 12;
      const top = 10;
      const bottom = 16;
      const plotWidth = width - left - right;
      const plotHeight = height - top - bottom;
      target.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      target.clearRect(0, 0, width, height);
      target.fillStyle = '#0f110f';
      target.fillRect(0, 0, width, height);
      target.strokeStyle = '#343733';
      target.strokeRect(left + 0.5, top + 0.5, plotWidth - 1, plotHeight - 1);

      const identity = identifyNeuron(manifest.populations, selectedNeuronId);
      const color = identity ? REGION_COLORS[identity.population.region] : '#c7c9c2';
      target.strokeStyle = color;
      target.lineWidth = expanded ? 1.4 : 1;
      target.beginPath();
      let visibleSpikeCount = 0;
      for (const spikeTime of selectedSpikeTimes) {
        if (spikeTime < startMs || spikeTime > endMs) continue;
        const x = left + (spikeTime - startMs) / Math.max(1, endMs - startMs) * plotWidth;
        target.moveTo(x + 0.5, top + 4);
        target.lineTo(x + 0.5, top + plotHeight - 4);
        visibleSpikeCount += 1;
      }
      target.stroke();

      const playheadX = left + (currentMs - startMs) / Math.max(1, endMs - startMs) * plotWidth;
      if (playheadX >= left && playheadX <= left + plotWidth) {
        target.strokeStyle = '#eef0e9';
        target.lineWidth = 1;
        target.beginPath();
        target.moveTo(playheadX + 0.5, top - 3);
        target.lineTo(playheadX + 0.5, top + plotHeight + 3);
        target.stroke();
      }
      target.fillStyle = '#cfd2cc';
      target.font = '9px Arial, sans-serif';
      target.textAlign = 'left';
      target.fillText(`${(startMs / 1_000).toFixed(expanded ? 2 : 1)} s`, left, height - 3);
      target.textAlign = 'right';
      target.fillText(`${(endMs / 1_000).toFixed(expanded ? 2 : 1)} s`, left + plotWidth, height - 3);
      if (expanded) windowSpikeLabel.textContent = `${visibleSpikeCount} spike${visibleSpikeCount === 1 ? '' : 's'} in window`;
    }

    function selectedVoltageDomain(): SignalDomain | undefined {
      if (!selectedVoltageDataset || selectedVoltageChannel < 0) return undefined;
      const offset = selectedVoltageChannel * selectedVoltageDataset.sampleCount;
      let minimum = Number.POSITIVE_INFINITY;
      let maximum = Number.NEGATIVE_INFINITY;
      for (let sample = 0; sample < selectedVoltageDataset.sampleCount; sample += 1) {
        const value = selectedVoltageDataset.samples[offset + sample];
        minimum = Math.min(minimum, value);
        maximum = Math.max(maximum, value);
      }
      if (minimum === maximum) return { min: minimum - 1, max: maximum + 1 };
      const padding = (maximum - minimum) * 0.04;
      return { min: minimum - padding, max: maximum + padding };
    }

    let voltageDomain: SignalDomain | undefined;

    function renderVoltage() {
      if (!selectedVoltageDataset || !selectedVoltageDescriptor || !voltageContext || !voltageDomain || voltageCanvas.hidden) return;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      const width = voltageCanvas.width / pixelRatio;
      const height = voltageCanvas.height / pixelRatio;
      const mobile = width < 520;
      const left = mobile ? 48 : 58;
      const right = 12;
      const top = 12;
      const bottom = 17;
      const plotWidth = Math.max(1, Math.floor(width - left - right));
      const plotHeight = height - top - bottom;
      const visible = getRollingWindow(currentMs, manifest.durationMs, traceWindowMs);
      voltageContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      voltageContext.clearRect(0, 0, width, height);
      voltageContext.fillStyle = '#0f110f';
      voltageContext.fillRect(0, 0, width, height);
      const envelope = downsampleMinMax(
        selectedVoltageDataset,
        selectedVoltageChannel,
        selectedVoltageDescriptor.sampleRateHz,
        visible.startMs,
        visible.endMs,
        plotWidth,
      );
      const identity = identifyNeuron(manifest.populations, selectedNeuronId);
      voltageContext.strokeStyle = identity ? REGION_COLORS[identity.population.region] : '#c7c9c2';
      voltageContext.beginPath();
      for (let pixel = 0; pixel < plotWidth; pixel += 1) {
        const x = left + pixel + 0.5;
        voltageContext.moveTo(x, yForValue(envelope.minimums[pixel], voltageDomain, top, plotHeight));
        voltageContext.lineTo(x, yForValue(envelope.maximums[pixel], voltageDomain, top, plotHeight));
      }
      voltageContext.stroke();
      const playheadX = left + (currentMs - visible.startMs) / (visible.endMs - visible.startMs) * plotWidth;
      voltageContext.strokeStyle = '#eef0e9';
      voltageContext.beginPath();
      voltageContext.moveTo(playheadX + 0.5, top);
      voltageContext.lineTo(playheadX + 0.5, top + plotHeight);
      voltageContext.stroke();
      voltageContext.strokeStyle = '#343733';
      voltageContext.strokeRect(left + 0.5, top + 0.5, plotWidth - 1, plotHeight - 1);
      voltageContext.fillStyle = '#cfd2cc';
      voltageContext.font = '9px Arial, sans-serif';
      voltageContext.textAlign = 'left';
      voltageContext.fillText(`${formatAxisValue(voltageDomain.max)} mV`, 6, top + 8);
      voltageContext.fillText(`${formatAxisValue(voltageDomain.min)} mV`, 6, top + plotHeight - 3);
      voltageContext.fillText(`${(visible.startMs / 1_000).toFixed(2)} s`, left, height - 3);
      voltageContext.textAlign = 'right';
      voltageContext.fillText(`${(visible.endMs / 1_000).toFixed(2)} s`, left + plotWidth, height - 3);
    }

    function rebuildFocusedPositions() {
      focusedPositions = new Map();
      if (selectedNeuronId < 0) return;
      const selectedIdentity = identifyNeuron(manifest.populations, selectedNeuronId);
      if (!selectedIdentity) return;
      const centerX = cssWidth / 2;
      const usableHeight = cssHeight - (cssWidth < 620 ? 196 : 130);
      const centerY = Math.max(120, usableHeight * 0.54);
      const selectedBaseX = neuronX(selectedNeuronId);
      const selectedBaseY = neuronY(selectedNeuronId);
      const zoomX = cssWidth < 620 ? 3.2 : 4.5;
      const zoomY = cssWidth < 620 ? 7 : 9;

      const population = selectedIdentity.population;
      for (let localId = 0; localId < population.count; localId += 1) {
        const neuronId = population.idStart + localId;
        const x = centerX + (neuronX(neuronId) - selectedBaseX) * zoomX;
        const y = centerY + (neuronY(neuronId) - selectedBaseY) * zoomY;
        if (x > 18 && x < cssWidth - 18 && y > 50 && y < usableHeight - 18) focusedPositions.set(neuronId, { x, y });
      }
      focusedPositions.set(selectedNeuronId, { x: centerX, y: centerY });

      const incomingIds = [...new Set(displayedConnections.filter((edge) => edge.targetId === selectedNeuronId && !focusedPositions.has(edge.sourceId)).map((edge) => edge.sourceId))];
      const outgoingIds = [...new Set(displayedConnections.filter((edge) => edge.sourceId === selectedNeuronId && !focusedPositions.has(edge.targetId)).map((edge) => edge.targetId))];
      const placeConnectionLane = (ids: number[], y: number) => ids.forEach((neuronId, index) => {
        const x = 40 + (index + 1) / (ids.length + 1) * Math.max(1, cssWidth - 80);
        focusedPositions.set(neuronId, { x, y });
      });
      placeConnectionLane(incomingIds, 74);
      placeConnectionLane(outgoingIds, Math.max(centerY + 70, usableHeight - 42));
    }

    function renderFocusedNetwork() {
      rebuildFocusedPositions();
      const selectedIdentity = identifyNeuron(manifest.populations, selectedNeuronId);
      if (!selectedIdentity) return;
      const displayPositions = new Map<number, { x: number; y: number }>();
      focusedPositions.forEach((target, neuronId) => {
        displayPositions.set(neuronId, {
          x: neuronX(neuronId) + (target.x - neuronX(neuronId)) * focusMix,
          y: neuronY(neuronId) + (target.y - neuronY(neuronId)) * focusMix,
        });
      });
      const selectedPoint = displayPositions.get(selectedNeuronId)!;

      context.fillStyle = '#101210';
      context.fillRect(0, 0, cssWidth, cssHeight);
      context.fillStyle = '#d7dad4';
      context.font = '11px Arial, sans-serif';
      context.textAlign = 'left';
      context.fillText(`${selectedIdentity.population.label} · neuron ${selectedNeuronId.toLocaleString()} · row focus`, 14, 20);
      context.fillStyle = '#cfd2cc';
      context.font = '9px Arial, sans-serif';
      context.fillText('One-hop neighbors are pulled into the focused row; edge color encodes synapse type.', 14, 35);

      for (const edge of displayedConnections) {
        const source = displayPositions.get(edge.sourceId);
        const target = displayPositions.get(edge.targetId);
        if (!source || !target) continue;
        context.strokeStyle = edge.synapseType === 'excitatory' ? 'rgba(224,227,221,.5)' : 'rgba(145,150,143,.58)';
        context.lineWidth = 1;
        context.beginPath();
        context.moveTo(source.x, source.y);
        context.lineTo(target.x, target.y);
        context.stroke();
        const progress = transmissionPulseProgress(edge, lastSpikeTicks, manifest.tickMs, currentMs);
        if (progress !== undefined) {
          context.fillStyle = edge.synapseType === 'excitatory' ? '#f0f2ed' : '#a2a7a0';
          context.beginPath();
          context.arc(source.x + (target.x - source.x) * progress, source.y + (target.y - source.y) * progress, 3, 0, Math.PI * 2);
          context.fill();
        }
      }

      for (const [neuronId, point] of displayPositions) {
        const identity = identifyNeuron(manifest.populations, neuronId);
        if (!identity || !visiblePopulations[populationByNeuron[neuronId]]) continue;
        const ageMs = (currentMs / manifest.tickMs - lastSpikeTicks[neuronId]) * manifest.tickMs;
        const active = ageMs >= 0 && ageMs <= ACTIVE_WINDOW_MS;
        const intensity = active ? Math.exp(-ageMs / DECAY_MS) : 0;
        const connected = displayedConnections.some((edge) => edge.sourceId === neuronId || edge.targetId === neuronId);
        const radius = neuronId === selectedNeuronId ? 8 : connected ? 4 : 2.2;
        context.fillStyle = hexToRgba(REGION_COLORS[identity.population.region], connected ? 0.8 : 0.26 + intensity * 0.6);
        traceNeuronShape(context, point.x, point.y, radius + intensity * 2, identity.population.cellType);
        if (identity.population.cellType === 'interneuron') {
          context.strokeStyle = hexToRgba(REGION_COLORS[identity.population.region], connected ? 0.9 : 0.4);
          context.lineWidth = 1;
          context.stroke();
        } else context.fill();
      }
      context.strokeStyle = '#eef0e9';
      context.lineWidth = 1.5;
      context.beginPath();
      context.arc(selectedPoint.x, selectedPoint.y, 12, 0, Math.PI * 2);
      context.stroke();
    }

    function updateDisplayedConnections() {
      const result = selectConnections(loadedConnectivity, selectedNeuronId, {
        direction: connectivityDirection.value as ConnectivityDirection,
        projectionId: connectivityProjection.value || undefined,
        synapseType: (connectivityType.value || undefined) as 'excitatory' | 'inhibitory' | undefined,
        limit: Number(connectivityLimit.value),
      });
      displayedConnections = result.edges;
      const filters: string[] = [];
      if (connectivityProjection.value) filters.push('projection');
      if (connectivityType.value) filters.push('synapse type');
      filters.push(connectivityDirection.value);
      const synthetic = connectivityDescriptor?.provenance === 'synthetic-ui-fixture';
      connectivityStatus.textContent = `${synthetic ? 'Synthetic UI fixture · ' : ''}${result.edges.length.toLocaleString()} of ${result.matchedCount.toLocaleString()} matching edges`;
      connectivityNote.textContent = `${synthetic ? 'Synthetic connectivity for interface demonstration only—not simulation output. Exact connections require an export from this run and seed. ' : ''}${connectivityDescriptor?.runId}, seed ${connectivityDescriptor?.seed}. Showing strongest weights first; ${filters.join(', ')} filter${filters.length === 1 ? '' : 's'} active.${result.truncated ? ` Truncated at ${result.edges.length} edges.` : ''} Click outside the selected neuron to return.`;
      rebuildFocusedPositions();
      render();
    }

    async function loadSelectedConnectivity(neuronId: number) {
      const request = ++connectivityRequest;
      loadedConnectivity = [];
      displayedConnections = [];
      connectivityControls.disabled = true;
      if (!connectivityDescriptor) {
        connectivityStatus.textContent = 'Exact export unavailable';
        connectivityNote.textContent = `${manifest.runId}${manifest.schemaVersion === 2 && manifest.condition ? `, seed ${manifest.condition.seed}` : ''} has no live-synapse connectivity artifact. No edges are reconstructed from its seed.`;
        return;
      }
      const identity = identifyNeuron(manifest.populations, neuronId);
      if (!identity) return;
      const relevant = connectivityDescriptor.projections.filter((projection) => projectionAppliesToSelection(projection, identity.population.id, connectivityDirection.value as ConnectivityDirection));
      const previousProjection = connectivityProjection.value;
      connectivityProjection.replaceChildren(new Option('All relevant', ''));
      relevant.forEach((projection) => connectivityProjection.add(new Option(projection.label, projection.id)));
      if (relevant.some((projection) => projection.id === previousProjection)) connectivityProjection.value = previousProjection;
      connectivityStatus.textContent = `Loading ${relevant.length} relevant projection${relevant.length === 1 ? '' : 's'}…`;
      try {
        loadedConnectivity = await Promise.all(relevant.map(async (descriptor) => {
          let pending = connectivityCache.get(descriptor.file);
          if (!pending) {
            pending = fetch(new URL(descriptor.file, manifestBaseUrl)).then(async (response) => {
              if (!response.ok) throw new Error(`HTTP ${response.status}`);
              const dataset = parseConnectivityDataset(await response.arrayBuffer(), descriptor, manifest.neuronCount);
              return { descriptor, dataset };
            });
            connectivityCache.set(descriptor.file, pending);
          }
          return pending;
        }));
        if (request !== connectivityRequest || selectedNeuronId !== neuronId) return;
        connectivityControls.disabled = false;
        updateDisplayedConnections();
      } catch (error) {
        if (request !== connectivityRequest) return;
        connectivityStatus.textContent = 'Exact connectivity unavailable';
        connectivityNote.textContent = `The seed-specific connectivity export could not be loaded (${error instanceof Error ? error.message : 'load failed'}). No edges are reconstructed.`;
      }
    }

    function renderInspector() {
      if (inspector.hidden || selectedNeuronId < 0 || !spikeHistoryContext || !windowSpikeContext) return;
      const visible = getRollingWindow(currentMs, manifest.durationMs, traceWindowMs);
      drawSpikeRaster(spikeHistoryContext, spikeHistoryCanvas, 0, manifest.durationMs, false);
      drawSpikeRaster(windowSpikeContext, windowSpikeCanvas, visible.startMs, visible.endMs, true);
      renderVoltage();
    }

    async function loadSelectedVoltage(neuronId: number) {
      const request = ++selectionRequest;
      selectedVoltageDataset = undefined;
      selectedVoltageDescriptor = undefined;
      selectedVoltageChannel = -1;
      voltageDomain = undefined;
      voltageCanvas.hidden = true;
      voltageUnavailable.hidden = true;
      const match = findVoltageChannel(voltageGroups, neuronId);
      if (!match) {
        voltageStatus.textContent = 'Not recorded';
        voltageUnavailable.textContent = 'Membrane voltage was not recorded for this neuron; no trace is synthesized or interpolated.';
        voltageUnavailable.hidden = false;
        return;
      }
      voltageStatus.textContent = 'Loading recorded trace…';
      try {
        let pending = voltageCache.get(match.descriptor.file);
        if (!pending) {
          pending = fetch(new URL(match.descriptor.file, manifestBaseUrl)).then(async (response) => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return parseSignalDataset(await response.arrayBuffer(), match.descriptor);
          });
          voltageCache.set(match.descriptor.file, pending);
        }
        const dataset = await pending;
        if (request !== selectionRequest || selectedNeuronId !== neuronId) return;
        selectedVoltageDataset = dataset;
        selectedVoltageDescriptor = match.descriptor;
        selectedVoltageChannel = match.channelIndex;
        voltageDomain = selectedVoltageDomain();
        voltageStatus.textContent = `Recorded at ${match.descriptor.sampleRateHz.toLocaleString()} Hz · ${match.descriptor.unit}`;
        voltageCanvas.hidden = false;
        prepareInspectorCanvases();
      } catch (error) {
        if (request !== selectionRequest) return;
        voltageCache.delete(match.descriptor.file);
        voltageStatus.textContent = 'Recorded trace unavailable';
        voltageUnavailable.textContent = `The recorded voltage could not be loaded (${error instanceof Error ? error.message : 'load failed'}).`;
        voltageUnavailable.hidden = false;
      }
    }

    function selectNeuron(neuronId: number) {
      const identity = identifyNeuron(manifest.populations, neuronId);
      if (!identity) return;
      const switchingFocus = selectedNeuronId >= 0 && selectedNeuronId !== neuronId;
      if (switchingFocus) focusMix = 0;
      selectedNeuronId = neuronId;
      selectedSpikeTimes = collectNeuronSpikeTimes(spikes, manifest.tickMs, neuronId);
      inspectorTitle.textContent = `${identity.population.region} ${identity.population.cellType} neuron ${neuronId}`;
      inspectorSummary.textContent = `${identity.population.label} · stable selection across both network layouts`;
      neuronIdOutput.textContent = neuronId.toLocaleString();
      neuronRegionOutput.textContent = identity.population.region;
      neuronCellTypeOutput.textContent = identity.population.cellType;
      neuronLocalIdOutput.textContent = identity.localId.toLocaleString();
      neuronSpikeCountOutput.textContent = spikeCounts[neuronId].toLocaleString();
      spikeHistoryLabel.textContent = `${selectedSpikeTimes.length.toLocaleString()} total spikes`;
      inspectorContent.hidden = false;
      connectivityBlock.hidden = false;
      root.classList.add('is-neuron-focused');
      connectivityBlock.style.opacity = String(focusMix);
      connectivityBlock.style.transform = `translateY(${(1 - focusMix) * 12}px)`;
      layoutButton.disabled = true;
      viewButton.disabled = true;
      layoutTitle.textContent = `Selected ${identity.population.label} neuron`;
      layoutDescription.textContent = 'Nearby neurons remain in row context while one-hop presynaptic and postsynaptic partners are drawn directly in the network.';
      layoutDescription.hidden = false;
      canvas.setAttribute('aria-label', `Focused network row for ${identity.population.label} neuron ${neuronId} with one-hop synaptic connections; click outside the selected neuron or press Escape to return`);
      animateNeuronView(1);
      if (!inspector.hidden) void loadSelectedVoltage(neuronId);
      void loadSelectedConnectivity(neuronId);
    }

    function clearNeuronSelection() {
      selectionRequest += 1;
      connectivityRequest += 1;
      connectivityControls.disabled = true;
      animateNeuronView(0, () => {
        selectedNeuronId = -1;
        selectedSpikeTimes = new Float32Array();
        selectedVoltageDataset = undefined;
        selectedVoltageDescriptor = undefined;
        selectedVoltageChannel = -1;
        inspectorTitle.textContent = 'Select a neuron';
        inspectorSummary.textContent = 'Choose a neuron in either network layout to inspect its identity and spike history.';
        inspectorContent.hidden = true;
        connectivityBlock.hidden = true;
        root.classList.remove('is-neuron-focused');
        layoutButton.disabled = false;
        viewButton.disabled = !rates;
        displayedConnections = [];
        loadedConnectivity = [];
        updateLayoutCopy(layoutTarget === 1);
        canvas.setAttribute('aria-label', 'Selectable animated spike activity across 3,450 PFC, CA3, and CA1 neurons, switchable between interspersed and separated layouts');
        render();
      });
    }

    function updateEventDetails() {
      const hasEvents = events.length > 0;
      previousEventButton.disabled = !hasEvents || selectedEventIndex <= 0;
      nextEventButton.disabled = !hasEvents || selectedEventIndex >= events.length - 1;
      focusEventButton.disabled = !hasEvents || selectedEventIndex < 0;
      if (!hasEvents || selectedEventIndex < 0) {
        eventDetails.value = 'No detected SPW-R events';
        return;
      }
      const event = events[selectedEventIndex];
      eventDetails.value = `Event ${selectedEventIndex + 1} of ${events.length} · onset ${(event.startMs / 1_000).toFixed(3)} s · duration ${Math.round(event.endMs - event.startMs)} ms · peak ${event.normalizedPeakPower.toFixed(2)} SD`;
    }

    function selectEventForTime(milliseconds: number) {
      if (events.length === 0) return;
      const next = events.findIndex((event) => event.endMs >= milliseconds);
      selectedEventIndex = next >= 0 ? next : events.length - 1;
      updateEventDetails();
    }

    function restoreFocusSpeed() {
      if (!focusActive) return;
      focusActive = false;
      speed = focusPreviousSpeed;
      speedSelect.value = String(speed);
    }

    function startEventFocus() {
      if (selectedEventIndex < 0) return;
      setPlaying(false);
      const event = events[selectedEventIndex];
      const range = focusPlaybackRange(event, manifest.durationMs);
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        seek(event.startMs, false);
        return;
      }
      focusPreviousSpeed = speed;
      focusActive = true;
      focusEndMs = range.endMs;
      speed = 0.25;
      speedSelect.value = '0.25';
      seek(range.startMs, false);
      setPlaying(true);
    }

    function reconstructActivity(milliseconds: number) {
      lastSpikeTicks.fill(-1_000_000_000);
      const currentTick = Math.floor(milliseconds / manifest.tickMs);
      const startTick = Math.max(0, Math.floor((milliseconds - ACTIVE_WINDOW_MS) / manifest.tickMs));
      const start = lowerBound(spikes.times, startTick);
      const end = lowerBound(spikes.times, currentTick + 1);
      for (let index = start; index < end; index += 1) lastSpikeTicks[spikes.neuronIds[index]] = spikes.times[index];
      eventCursor = end;
    }

    function renderPopulationActivity() {
      if (!rates || !rateDescriptor) return;
      const mobile = cssWidth < 520;
      const left = mobile ? 74 : 108;
      const right = 16;
      const plotWidth = Math.max(1, Math.floor(cssWidth - left - right));
      const visible = getRollingWindow(currentMs, manifest.durationMs, traceWindowMs);
      const windowDuration = Math.max(1, visible.endMs - visible.startMs);
      const groupsTop = 36;
      const groupsBottom = 22;
      const groupGap = mobile ? 3 : 5;
      const groupHeight = (cssHeight - groupsTop - groupsBottom - groupGap * (manifest.populations.length - 1)) / manifest.populations.length;
      const rasterHeight = groupHeight * 0.54;
      const rateHeight = groupHeight - rasterHeight;
      const playheadX = left + (currentMs - visible.startMs) / windowDuration * plotWidth;

      context.fillStyle = '#101210';
      context.fillRect(0, 0, cssWidth, cssHeight);
      context.fillStyle = '#d7dad4';
      context.font = '10px Arial, sans-serif';
      context.textAlign = 'left';
      context.textBaseline = 'top';
      context.fillText('POPULATION SPIKES + SMOOTHED ACTIVITY', 14, 12);
      context.fillStyle = '#aeb2ac';
      context.font = '9px Arial, sans-serif';

      for (let populationIndex = 0; populationIndex < manifest.populations.length; populationIndex += 1) {
        const population = manifest.populations[populationIndex];
        const groupTop = groupsTop + populationIndex * (groupHeight + groupGap);
        const rateTop = groupTop + rasterHeight;
        const color = REGION_COLORS[population.region];
        const emphasized = population.region === 'CA1';
        const visiblePopulation = visiblePopulations[populationIndex];
        const channel = rateDescriptor.channels.findIndex((metadata) => metadata.id === population.id);
        const maximum = Math.max(1, channel >= 0 ? rateDomains[channel]?.max ?? 1 : 1);
        const domain = { min: 0, max: maximum };

        context.fillStyle = emphasized ? '#141714' : populationIndex % 2 === 0 ? '#111310' : '#10120f';
        context.fillRect(left, groupTop, plotWidth, rasterHeight);
        context.fillStyle = emphasized ? '#111411' : populationIndex % 2 === 0 ? '#0e100e' : '#0f110f';
        context.fillRect(left, rateTop, plotWidth, rateHeight);
        context.fillStyle = visiblePopulation ? (emphasized ? '#f3f4f0' : '#d4d7d1') : '#777b75';
        context.font = `${mobile ? 9 : 10}px Arial, sans-serif`;
        context.textAlign = 'left';
        context.fillText(population.region, 14, groupTop + 3);
        context.font = `${mobile ? 8 : 9}px Arial, sans-serif`;
        context.fillText(population.cellType === 'pyramidal' ? 'PYRAMIDAL' : 'INTERNEURON', 14, groupTop + 15);
        context.fillStyle = '#cfd2cc';
        context.font = '8px Arial, sans-serif';
        context.fillText(`RATE ≤ ${formatAxisValue(maximum)}`, 14, rateTop + Math.max(2, rateHeight - 10));

        if (channel >= 0 && visiblePopulation) {
          const envelope = downsampleMinMax(rates, channel, rateDescriptor.sampleRateHz, visible.startMs, visible.endMs, plotWidth);
          context.strokeStyle = color;
          context.lineWidth = population.cellType === 'interneuron' ? 1.35 : 1.15;
          context.setLineDash(population.cellType === 'interneuron' ? [4, 3] : []);
          context.beginPath();
          for (let pixel = 0; pixel < plotWidth; pixel += 1) {
            const value = (envelope.minimums[pixel] + envelope.maximums[pixel]) / 2;
            const x = left + pixel + 0.5;
            const y = yForValue(value, domain, rateTop + 2, rateHeight - 4);
            if (pixel === 0) context.moveTo(x, y);
            else context.lineTo(x, y);
          }
          context.stroke();
          context.setLineDash([]);
        }

        context.strokeStyle = emphasized ? '#666b64' : '#2f322e';
        context.lineWidth = 1;
        context.strokeRect(left + 0.5, groupTop + 0.5, plotWidth - 1, groupHeight - 1);
        context.strokeStyle = '#242724';
        context.beginPath();
        context.moveTo(left, rateTop + 0.5);
        context.lineTo(left + plotWidth, rateTop + 0.5);
        context.stroke();
      }

      const startTick = Math.max(0, Math.floor(visible.startMs / manifest.tickMs));
      const endTick = Math.ceil(visible.endMs / manifest.tickMs);
      const startSpike = lowerBound(spikes.times, startTick);
      const endSpike = lowerBound(spikes.times, endTick + 1);
      for (let index = startSpike; index < endSpike; index += 1) {
        const neuronId = spikes.neuronIds[index];
        const populationIndex = populationByNeuron[neuronId];
        if (!visiblePopulations[populationIndex]) continue;
        const population = manifest.populations[populationIndex];
        const spikeMs = spikes.times[index] * manifest.tickMs;
        const x = left + (spikeMs - visible.startMs) / windowDuration * plotWidth;
        const localFraction = (neuronId - population.idStart + 0.5) / population.count;
        const groupTop = groupsTop + populationIndex * (groupHeight + groupGap);
        const y = groupTop + localFraction * rasterHeight;
        context.fillStyle = hexToRgba(REGION_COLORS[population.region], 0.62);
        context.fillRect(x, y, cssWidth < 520 ? 1 : 1.25, 1);
      }

      context.strokeStyle = 'rgba(235, 237, 230, .72)';
      context.lineWidth = 1;
      context.beginPath();
      context.moveTo(playheadX + 0.5, groupsTop);
      context.lineTo(playheadX + 0.5, cssHeight - groupsBottom);
      context.stroke();
      context.fillStyle = '#cfd2cc';
      context.font = '9px Arial, sans-serif';
      context.textAlign = 'left';
      context.fillText(`${(visible.startMs / 1_000).toFixed(2)} s`, left, cssHeight - 10);
      context.textAlign = 'right';
      context.fillText(`${(visible.endMs / 1_000).toFixed(2)} s`, left + plotWidth, cssHeight - 10);
    }

    function render() {
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      context.setTransform(1, 0, 0, 1, 0, 0);
      context.clearRect(0, 0, canvas.width, canvas.height);
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      const normalAlpha = 1 - focusMix;
      if (networkView === 'activity' && selectedNeuronId < 0) {
        renderPopulationActivity();
      } else if (normalAlpha > 0.001) {
        context.globalAlpha = normalAlpha;
        context.setTransform(1, 0, 0, 1, 0, 0);
        context.drawImage(backgroundCanvas, 0, 0);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        const currentTick = currentMs / manifest.tickMs;
        for (let neuronId = 0; neuronId < manifest.neuronCount; neuronId += 1) {
          const populationIndex = populationByNeuron[neuronId];
          if (!visiblePopulations[populationIndex]) continue;
          const ageMs = (currentTick - lastSpikeTicks[neuronId]) * manifest.tickMs;
          if (ageMs < 0 || ageMs > ACTIVE_WINDOW_MS) continue;
          const population = manifest.populations[populationIndex];
          const intensity = Math.exp(-ageMs / DECAY_MS);
          const baseRadius = cssWidth < 520 ? 1.05 : 1.4;
          const radius = baseRadius + intensity * (cssWidth < 520 ? 2.55 : 3.5);
          const color = REGION_COLORS[population.region];
          context.fillStyle = hexToRgba(color, intensity * 0.95);
          traceNeuronShape(context, neuronX(neuronId), neuronY(neuronId), radius, population.cellType);
          context.fill();
          if (population.cellType === 'interneuron') {
            context.strokeStyle = hexToRgba('#ffffff', intensity * 0.8);
            context.lineWidth = 0.7;
            context.stroke();
          }
        }
        context.globalAlpha = 1;
      }
      if (selectedNeuronId >= 0 && focusMix > 0.001) {
        context.globalAlpha = focusMix;
        renderFocusedNetwork();
        context.globalAlpha = 1;
      }
      timeline.value = String(Math.round(currentMs));
      timeOutput.value = formatTime(currentMs);
      renderSignalViews();
      renderRateViews();
      renderInspector();
    }

    function advance(now: number) {
      if (!playing) return;
      const playbackLimit = focusActive ? focusEndMs : manifest.durationMs;
      const nextMs = Math.min(playbackLimit, anchorSimulationMs + (now - anchorRealMs) * speed);
      const nextTick = Math.floor(nextMs / manifest.tickMs);
      const end = lowerBound(spikes.times, nextTick + 1);
      for (let index = eventCursor; index < end; index += 1) lastSpikeTicks[spikes.neuronIds[index]] = spikes.times[index];
      eventCursor = end;
      currentMs = nextMs;
      while (selectedEventIndex + 1 < events.length && currentMs >= events[selectedEventIndex + 1].startMs) {
        selectedEventIndex += 1;
        updateEventDetails();
      }
      render();
      if (focusActive && currentMs >= focusEndMs) {
        playing = false;
        cancelAnimationFrame(frameRequest);
        restoreFocusSpeed();
        playButton.textContent = 'Play';
        playButton.setAttribute('aria-pressed', 'false');
        render();
        return;
      }
      if (currentMs >= manifest.durationMs) {
        setPlaying(false);
        return;
      }
      frameRequest = requestAnimationFrame(advance);
    }

    function setPlaying(nextPlaying: boolean) {
      if (!nextPlaying) restoreFocusSpeed();
      playing = nextPlaying;
      cancelAnimationFrame(frameRequest);
      playButton.textContent = playing ? 'Pause' : currentMs >= manifest.durationMs ? 'Replay' : 'Play';
      playButton.setAttribute('aria-pressed', String(playing));
      if (playing) {
        if (currentMs >= manifest.durationMs) seek(0);
        anchorRealMs = performance.now();
        anchorSimulationMs = currentMs;
        frameRequest = requestAnimationFrame(advance);
      }
    }

    function seek(milliseconds: number, syncEvent = true) {
      currentMs = Math.max(0, Math.min(manifest.durationMs, milliseconds));
      if (syncEvent) selectEventForTime(currentMs);
      reconstructActivity(currentMs);
      anchorRealMs = performance.now();
      anchorSimulationMs = currentMs;
      render();
    }

    function updateLayoutCopy(interspersed: boolean) {
      layoutButton.textContent = interspersed ? 'Layout: interspersed' : 'Layout: separated';
      layoutButton.setAttribute('aria-pressed', String(interspersed));
      layoutTitle.textContent = interspersed ? 'Interspersed neuron view' : 'Separated neuron lanes';
      layoutDescription.textContent = '';
      layoutDescription.hidden = true;
    }

    function setNetworkView(nextView: 'neurons' | 'activity') {
      if (nextView === 'activity' && !rates) return;
      cancelAnimationFrame(layoutAnimationRequest);
      networkView = nextView;
      const activity = networkView === 'activity';
      root.classList.toggle('is-activity-view', activity);
      viewButton.textContent = activity ? 'View: population activity' : 'View: neurons';
      viewButton.setAttribute('aria-pressed', String(activity));
      layoutButton.disabled = activity;
      canvasKey.hidden = activity;
      if (activity) {
        viewLabel.textContent = 'View';
        layoutTitle.textContent = 'Population rasters and firing rates';
        layoutDescription.textContent = '';
        layoutDescription.hidden = true;
        canvas.setAttribute('aria-label', 'Six synchronized PFC, CA3, and CA1 population groups, each with a spike raster followed by a smoothed firing-rate trace');
        simulationNote.textContent = 'Pyramidal and interneuron populations are separated by region. Within each group, the running spike raster appears directly above its smoothed firing rate.';
      } else {
        updateLayoutCopy(layoutTarget === 1);
        canvas.setAttribute('aria-label', 'Selectable animated spike activity across 3,450 PFC, CA3, and CA1 neurons, with an alternate population activity and spike raster view');
        simulationNote.textContent = 'Each symbol is one model neuron: triangles are pyramidal neurons and circles are interneurons. Brightness and size encode a recent spike with a short visual decay.';
      }
      render();
    }

    function animateLayout(nextTarget: number) {
      cancelAnimationFrame(layoutAnimationRequest);
      layoutTarget = nextTarget;
      updateLayoutCopy(layoutTarget === 1);

      const startMix = layoutMix;
      const duration = 560;
      const startedAt = performance.now();
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

      const step = (now: number) => {
        const progress = Math.min(1, (now - startedAt) / duration);
        const eased = 0.5 - Math.cos(progress * Math.PI) / 2;
        layoutMix = startMix + (layoutTarget - startMix) * eased;
        drawBackground(pixelRatio, layoutLabelWidth, layoutTopPadding, layoutGap, layoutBandHeight);
        render();
        if (progress < 1) layoutAnimationRequest = requestAnimationFrame(step);
      };

      layoutAnimationRequest = requestAnimationFrame(step);
    }

    function animateNeuronView(nextTarget: number, onComplete?: () => void) {
      cancelAnimationFrame(focusAnimationRequest);
      const startMix = focusMix;
      const duration = 520;
      const startedAt = performance.now();
      const step = (now: number) => {
        const progress = Math.min(1, (now - startedAt) / duration);
        const eased = 0.5 - Math.cos(progress * Math.PI) / 2;
        focusMix = startMix + (nextTarget - startMix) * eased;
        connectivityBlock.style.opacity = String(focusMix);
        connectivityBlock.style.transform = `translateY(${(1 - focusMix) * 12}px)`;
        connectivityBlock.style.pointerEvents = focusMix > 0.85 ? 'auto' : 'none';
        render();
        if (progress < 1) focusAnimationRequest = requestAnimationFrame(step);
        else onComplete?.();
      };
      focusAnimationRequest = requestAnimationFrame(step);
    }

    playButton.addEventListener('click', () => setPlaying(!playing));
    restartButton.addEventListener('click', () => {
      setPlaying(false);
      seek(0);
    });
    timeline.addEventListener('input', () => {
      setPlaying(false);
      seek(Number(timeline.value));
    });
    speedSelect.addEventListener('change', () => {
      const nextSpeed = Number(speedSelect.value);
      restoreFocusSpeed();
      speed = nextSpeed;
      speedSelect.value = String(nextSpeed);
      anchorRealMs = performance.now();
      anchorSimulationMs = currentMs;
    });
    traceWindowSelect.addEventListener('change', () => {
      traceWindowMs = Number(traceWindowSelect.value);
      render();
    });
    rateToggle.addEventListener('click', () => {
      ratesExpanded = !ratesExpanded;
      rateCanvas.hidden = !ratesExpanded;
      rateToggle.textContent = ratesExpanded ? 'Collapse rates' : 'Expand rates';
      rateToggle.setAttribute('aria-expanded', String(ratesExpanded));
      if (ratesExpanded) rebuildRateCanvas();
    });
    previousEventButton.addEventListener('click', () => {
      setPlaying(false);
      selectedEventIndex = previousEventIndex(events, currentMs, selectedEventIndex);
      updateEventDetails();
      if (selectedEventIndex >= 0) seek(events[selectedEventIndex].startMs, false);
    });
    nextEventButton.addEventListener('click', () => {
      setPlaying(false);
      selectedEventIndex = nextEventIndex(events, currentMs, selectedEventIndex);
      updateEventDetails();
      if (selectedEventIndex >= 0) seek(events[selectedEventIndex].startMs, false);
    });
    focusEventButton.addEventListener('click', startEventFocus);
    function seekFromOverview(clientX: number) {
      const rect = overviewCanvas.getBoundingClientRect();
      const fraction = Math.max(0, Math.min(1, (clientX - rect.left - 10) / Math.max(1, rect.width - 20)));
      setPlaying(false);
      seek(fraction * manifest.durationMs);
    }
    overviewCanvas.addEventListener('pointerdown', (event) => seekFromOverview(event.clientX));
    overviewCanvas.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      setPlaying(false);
      seek(currentMs + (event.key === 'ArrowRight' ? 100 : -100));
    });
    viewButton.addEventListener('click', () => setNetworkView(networkView === 'neurons' ? 'activity' : 'neurons'));
    layoutButton.addEventListener('click', () => animateLayout(layoutTarget === 1 ? 0 : 1));
    function selectNeuronAt(clientX: number, clientY: number) {
      if (networkView === 'activity') return;
      const rect = canvas.getBoundingClientRect();
      const x = clientX - rect.left;
      const y = clientY - rect.top;
      if (selectedNeuronId >= 0) {
        const selectedPoint = focusedPositions.get(selectedNeuronId);
        if (!selectedPoint || Math.hypot(x - selectedPoint.x, y - selectedPoint.y) > (cssWidth < 520 ? 16 : 14)) clearNeuronSelection();
        return;
      }
      const displayX = new Float32Array(manifest.neuronCount);
      const displayY = new Float32Array(manifest.neuronCount);
      for (let neuronId = 0; neuronId < manifest.neuronCount; neuronId += 1) {
        displayX[neuronId] = neuronX(neuronId);
        displayY[neuronId] = neuronY(neuronId);
      }
      const neuronId = nearestNeuronId(
        x,
        y,
        displayX,
        displayY,
        cssWidth < 520 ? 12 : 9,
        (candidate) => visiblePopulations[populationByNeuron[candidate]],
      );
      if (neuronId >= 0) selectNeuron(neuronId);
    }
    canvas.addEventListener('click', (event) => selectNeuronAt(event.clientX, event.clientY));
    canvas.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && selectedNeuronId >= 0) {
        event.preventDefault();
        clearNeuronSelection();
        return;
      }
      const directions: Record<string, number> = { ArrowLeft: -1, ArrowUp: -1, ArrowRight: 1, ArrowDown: 1 };
      if ((event.key === 'Enter' || event.key === ' ') && selectedNeuronId < 0) {
        event.preventDefault();
        selectNeuron(0);
        return;
      }
      const direction = directions[event.key];
      if (!direction) return;
      event.preventDefault();
      let candidate = selectedNeuronId < 0 ? (direction > 0 ? 0 : manifest.neuronCount - 1) : selectedNeuronId + direction;
      while (candidate >= 0 && candidate < manifest.neuronCount) {
        if (visiblePopulations[populationByNeuron[candidate]]) {
          selectNeuron(candidate);
          break;
        }
        candidate += direction;
      }
    });
    connectivityDirection.addEventListener('change', () => {
      if (selectedNeuronId >= 0) void loadSelectedConnectivity(selectedNeuronId);
    });
    [connectivityProjection, connectivityType, connectivityLimit].forEach((control) => control.addEventListener('change', updateDisplayedConnections));
    toggles.forEach((toggle) => toggle.addEventListener('change', () => {
      const populationIndex = manifest.populations.findIndex((population) => population.id === toggle.value);
      if (populationIndex >= 0) visiblePopulations[populationIndex] = toggle.checked;
      rebuildLayout();
    }));
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && playing) setPlaying(false);
    });

    const resizeObserver = new ResizeObserver(() => {
      if (manifest) {
        rebuildLayout();
        rebuildSignalCanvases();
        rebuildRateCanvas();
        prepareInspectorCanvases();
      }
    });
    resizeObserver.observe(canvas);
    resizeObserver.observe(currentCanvas);
    resizeObserver.observe(rateCanvas);
    resizeObserver.observe(inspector);

    async function load() {
      try {
        const manifestUrl = root.dataset.manifestUrl;
        if (!manifestUrl) throw new Error('Simulation data URL is missing.');
        const manifestResponse = await fetch(manifestUrl);
        if (!manifestResponse.ok) throw new Error(`Simulation manifest could not be loaded (${manifestResponse.status}).`);
        manifest = validateManifest(await manifestResponse.json());
        manifestBaseUrl = manifestResponse.url;
        const spikeUrl = new URL(manifest.spikeFile, manifestResponse.url);
        const spikeResponse = await fetch(spikeUrl);
        if (!spikeResponse.ok) throw new Error(`Spike data could not be loaded (${spikeResponse.status}).`);
        spikes = parseSpikeDataset(await spikeResponse.arrayBuffer(), manifest);

        const optionalFailures: string[] = [];
        if (manifest.schemaVersion === 2) {
          const versionTwo = manifest as SimulationManifestV2;
          currentDescriptor = versionTwo.signalGroups?.find((group) => group.semanticRole === 'model-current');
          if (currentDescriptor) {
            try {
              const currentResponse = await fetch(new URL(currentDescriptor.file, manifestResponse.url));
              if (!currentResponse.ok) throw new Error(`HTTP ${currentResponse.status}`);
              currents = parseSignalDataset(await currentResponse.arrayBuffer(), currentDescriptor);
              currentDomains = computeFixedDomains(currents);
            } catch (error) {
              optionalFailures.push(`current traces (${error instanceof Error ? error.message : 'load failed'})`);
            }
          }
          rateDescriptor = versionTwo.signalGroups?.find((group) => group.semanticRole === 'population-firing-rate');
          if (rateDescriptor) {
            try {
              const rateResponse = await fetch(new URL(rateDescriptor.file, manifestResponse.url));
              if (!rateResponse.ok) throw new Error(`HTTP ${rateResponse.status}`);
              rates = parseSignalDataset(await rateResponse.arrayBuffer(), rateDescriptor);
              rateDomains = computeRateDomains(rates);
            } catch (error) {
              optionalFailures.push(`population rates (${error instanceof Error ? error.message : 'load failed'})`);
            }
          }
          voltageGroups = versionTwo.voltageGroups ?? [];
          connectivityDescriptor = versionTwo.connectivity;
          if (versionTwo.events) {
            try {
              const eventResponse = await fetch(new URL(versionTwo.events.file, manifestResponse.url));
              if (!eventResponse.ok) throw new Error(`HTTP ${eventResponse.status}`);
              events = validateEventsDocument(await eventResponse.json(), versionTwo.events.count).events;
              selectedEventIndex = events.length > 0 ? 0 : -1;
            } catch (error) {
              optionalFailures.push(`SPW-R events (${error instanceof Error ? error.message : 'load failed'})`);
            }
          }
        } else {
          optionalFailures.push('schema-v1 data provides spike-only replay');
        }

        lastSpikeTicks = new Int32Array(manifest.neuronCount);
        spikeCounts = countSpikesByNeuron(spikes, manifest.neuronCount);
        visiblePopulations = manifest.populations.map(() => true);
        timeline.max = String(manifest.durationMs);
        [playButton, restartButton, layoutButton, timeline, speedSelect].forEach((control) => { control.disabled = false; });
        populationControls.disabled = false;
        if (currents && currentContext && overviewContext) {
          signalPanel.hidden = false;
          traceWindowSelect.disabled = false;
        } else if (currents) {
          optionalFailures.push('signal canvas rendering is unavailable');
          currents = undefined;
        }
        if (rates) viewButton.disabled = false;
        updateEventDetails();
        if (optionalFailures.length > 0) showOptionalWarning(`Optional data unavailable: ${optionalFailures.join('; ')}. Spike replay remains available.`);
        const eventSummary = events.length > 0 ? ` · ${events.length} detected SPW-Rs` : '';
        loadStatus.textContent = `${manifest.label} · ${manifest.neuronCount.toLocaleString()} neurons · ${manifest.eventCount.toLocaleString()} spikes${eventSummary}`;
        root.setAttribute('aria-busy', 'false');
        reconstructActivity(0);
        rebuildLayout();
        rebuildSignalCanvases();
        rebuildRateCanvas();
      } catch (error) {
        showError(error instanceof Error ? error.message : 'The simulation could not be loaded.');
      }
    }

    load();
  });
</script>

