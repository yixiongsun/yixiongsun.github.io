---
import results from '../../../data/neural-event-robustness.json';

const full = results.models.find((model) => model.model === 'original_full_baseline')!;
const compact = results.models.find((model) => model.model === 'frozen_compact_model')!;
const thresholdPosition = (value: number) =>
  `${((value - results.threshold_axis.minimum) /
    (results.threshold_axis.maximum - results.threshold_axis.minimum)) * 100}%`;
const percentage = (value: number) => `${(value * 100).toFixed(1)}%`;
---

<section class="robustness-ablation" aria-labelledby="robustness-title">
  <header class="robustness-intro">
    <p>Model selection</p>
    <div>
      <h2 id="robustness-title">Comparable accuracy with lower computational cost</h2>
      <p>
        The compact model was chosen for efficiency rather than improved predictive performance. 
        A separate calibration analysis shows that its rejection threshold must be estimated independently.
      </p>
    </div>
  </header>

  <figure>
    <div class="robustness-panels">
      <section class="efficiency-panel" aria-labelledby="efficiency-title">
        <header>
          <div><span>A</span><h3 id="efficiency-title">Architecture trade-off</h3></div>
          <p>Final confirmation</p>
        </header>

        <div class="comparison-head" aria-hidden="true">
          <span>Measure</span><span>Full</span><span>Compact</span><span>Change</span>
        </div>
        <div class="comparison-table">
          <div class="comparison-row performance-row">
            <strong>Macro F1</strong>
            <span>{full.macro_f1_mean.toFixed(4)}</span>
            <span>{compact.macro_f1_mean.toFixed(4)}</span>
            <b>+{(compact.macro_f1_mean - full.macro_f1_mean).toFixed(4)}</b>
          </div>
          <div class="comparison-row">
            <strong>Parameters</strong>
            <span>{full.parameter_count.toLocaleString('en-US')}</span>
            <span>{compact.parameter_count.toLocaleString('en-US')}</span>
            <b>−{percentage(results.efficiency.parameter_reduction)}</b>
            <div class="comparison-bars" aria-hidden="true">
              <i class="full-bar"></i>
              <i class="compact-bar parameter-bar"></i>
            </div>
          </div>
          <div class="comparison-row">
            <strong>Mean training time</strong>
            <span>{Math.round(full.training_time_seconds_mean)} s</span>
            <span>{Math.round(compact.training_time_seconds_mean)} s</span>
            <b>−{percentage(results.efficiency.training_time_reduction)}</b>
            <div class="comparison-bars" aria-hidden="true">
              <i class="full-bar"></i>
              <i class="compact-bar time-bar"></i>
            </div>
          </div>
        </div>
        <p class="panel-takeaway">
          Predictive performance is effectively tied; the compact model removes the spectrogram
          branch and temporal convolution.
        </p>
      </section>

      <section class="calibration-panel" aria-labelledby="calibration-title">
        <header>
          <div><span>B</span><h3 id="calibration-title">Calibration sensitivity</h3></div>
          <p>15 runs per setting</p>
        </header>

        <div class="threshold-axis" aria-hidden="true">
          <span>Threshold</span><i>0</i><i>3</i><i>6</i>
        </div>
        <div class="fraction-groups">
          {results.calibration_fractions.map((group) => (
            <div class:list={['fraction-group', { selected: group.selected }]}>
              <div class="fraction-label">
                <p><strong>{Math.round(group.fraction * 100)}% calibration</strong>{group.selected && <em>selected</em>}</p>
                <span>mean macro F1 {group.macro_f1_mean.toFixed(3)}</span>
              </div>
              <div class="threshold-track" aria-label={`${Math.round(group.fraction * 100)} percent calibration thresholds`}>
                {group.thresholds.map((threshold, index) => (
                  <i
                    class="threshold-dot"
                    style={`--x: ${thresholdPosition(threshold)}; --row: ${index % 3}`}
                    title={`Threshold ${threshold.toFixed(2)}`}
                  ></i>
                ))}
                <b style={`--mean: ${thresholdPosition(group.threshold_mean)}`} title={`Mean ${group.threshold_mean.toFixed(2)}`}></b>
              </div>
              <span class="threshold-mean">mean threshold {group.threshold_mean.toFixed(2)} ± {group.threshold_sd.toFixed(2)}</span>
            </div>
          ))}
        </div>
        <p class="panel-takeaway">
          The 20% fraction had the highest average macro F1, but the fitted threshold still varied
          substantially across subject splits and seeds.
        </p>
      </section>
    </div>

    <figcaption>
      Architecture values come from the final five-fold, three-seed confirmation. Calibration
      fractions were compared in a separate matched robustness experiment. Thresholds are fitted
      from training-side calibration subjects and should not be treated as universal constants.
    </figcaption>
  </figure>
</section>

<style>
  .robustness-ablation {
    margin: 0 0 var(--project-section-gap);
    padding: 28px 0 0;
    border-top: 1px solid var(--rule);
  }
  .robustness-intro {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 28px;
    margin-bottom: 26px;
  }
  .robustness-intro > p {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: var(--project-label-size);
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .robustness-intro h2 {
    margin: 0;
    color: var(--text-strong);
    font-size: var(--project-heading-size);
    line-height: 1.3;
    font-weight: 400;
    letter-spacing: -.01em;
  }
  .robustness-intro div > p {
    max-width: 620px;
    margin: 14px 0 0;
    color: var(--text);
    font-size: var(--project-body-size);
    line-height: var(--project-body-leading);
  }

  figure { margin: 0; }
  .robustness-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .efficiency-panel,
  .calibration-panel { min-width: 0; padding: 17px; border: 1px solid var(--rule); background: #141513; }
  .efficiency-panel > header,
  .calibration-panel > header { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 13px; border-bottom: 1px solid var(--subtle-rule); }
  .efficiency-panel header div,
  .calibration-panel header div { display: flex; align-items: baseline; gap: 9px; }
  .efficiency-panel header span,
  .calibration-panel header span { color: var(--faint); font-size: 9px; }
  .efficiency-panel h3,
  .calibration-panel h3 { margin: 0; color: var(--text); font-size: 12px; font-weight: 500; }
  .efficiency-panel header p,
  .calibration-panel header p { margin: 0; color: var(--text); font-size: var(--project-support-size); }

  .comparison-head,
  .comparison-row { display: grid; grid-template-columns: 1.35fr .72fr .72fr .65fr; gap: 8px; align-items: baseline; }
  .comparison-head { padding: 16px 0 8px; color: var(--faint); font-size: 8px; }
  .comparison-head span:not(:first-child) { text-align: right; }
  .comparison-row { position: relative; padding: 14px 0 23px; border-top: 1px solid var(--subtle-rule); }
  .comparison-row strong { color: var(--text); font-size: 10px; line-height: 1.35; font-weight: 500; }
  .comparison-row > span,
  .comparison-row > b { color: var(--muted); font-size: 9px; font-weight: 400; text-align: right; font-variant-numeric: tabular-nums; }
  .comparison-row > b { color: var(--text); }
  .performance-row { padding-bottom: 14px; }
  .comparison-bars { position: absolute; right: 0; bottom: 8px; left: 0; height: 7px; }
  .comparison-bars i { position: absolute; left: 0; height: 2px; }
  .full-bar { top: 0; width: 100%; background: #535550; }
  .compact-bar { bottom: 0; background: #deded9; }
  .parameter-bar { width: 64.9%; }
  .time-bar { width: 50.5%; }

  .threshold-axis { display: grid; grid-template-columns: 1fr auto auto auto; gap: 0; margin: 16px 0 7px; color: var(--faint); font-size: 8px; }
  .threshold-axis i { width: 46px; font-style: normal; text-align: right; }
  .fraction-groups { display: grid; gap: 8px; }
  .fraction-group { padding: 11px 10px 10px; border: 1px solid var(--subtle-rule); }
  .fraction-group.selected { border-color: #777873; background: #191a18; }
  .fraction-label { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .fraction-label p { display: flex; align-items: center; gap: 7px; margin: 0; }
  .fraction-label strong { color: var(--text); font-size: 10px; font-weight: 500; }
  .fraction-label em { padding: 2px 5px; border: 1px solid #686964; color: var(--muted); font-size: 7px; font-style: normal; text-transform: uppercase; letter-spacing: .04em; }
  .fraction-label > span { color: var(--muted); font-size: 8px; font-variant-numeric: tabular-nums; }
  .threshold-track { position: relative; height: 28px; margin-top: 8px; border-top: 1px solid #454641; border-bottom: 1px solid #454641; background: linear-gradient(90deg, transparent 49.8%, #2d2e2b 50%, transparent 50.2%); }
  .threshold-dot { position: absolute; top: calc(5px + var(--row) * 7px); left: var(--x); width: 4px; height: 4px; border-radius: 50%; background: #92938d; transform: translateX(-50%); }
  .threshold-track b { position: absolute; top: 0; bottom: 0; left: var(--mean); width: 2px; background: #deded9; transform: translateX(-50%); }
  .threshold-mean { display: block; margin-top: 6px; color: var(--faint); font-size: 8px; font-variant-numeric: tabular-nums; }

  .panel-takeaway { margin: 18px 0 0; padding-top: 13px; border-top: 1px solid var(--subtle-rule); color: var(--muted); font-size: 9px; line-height: 1.55; }
  figcaption { margin: 14px 0 0 140px; color: var(--muted); font-size: var(--project-support-size); line-height: 1.6; }

  @media (max-width: 620px) {
    .robustness-intro { grid-template-columns: 1fr; gap: 12px; }
    .robustness-intro h2 { font-size: var(--project-heading-size); }
    .robustness-panels { grid-template-columns: 1fr; }
    .comparison-head,
    .comparison-row { grid-template-columns: 1.2fr .72fr .72fr .65fr; }
    figcaption { margin-left: 0; }
  }
</style>
