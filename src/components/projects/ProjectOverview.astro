---
import type { Project } from '../../data/portfolio';

interface Props { project: Project }
const { project } = Astro.props;
const overview = project.overview;
---

<section class="project-overview" aria-labelledby={`${project.slug}-overview`}>
  <h2 id={`${project.slug}-overview`} class="section-label">Overview</h2>
  <div class="section-body">
    {overview?.heading && <h3>{overview.heading}</h3>}
    <p>{overview?.text ?? project.description}</p>
    {project.overviewAction && (
      <a class="overview-action" href={project.overviewAction.href}>
        {project.overviewAction.label}
      </a>
    )}
  </div>
</section>

<style>
  .project-overview {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 28px;
    padding: 28px 0 var(--project-section-gap);
    border-top: 1px solid var(--rule);
  }
  .section-label {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: var(--project-label-size);
    line-height: 1.4;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .section-body { min-width: 0; }
  .overview-action { display: inline-flex; align-items: center; gap: 12px; min-height: 40px; margin-top: 18px; padding: 9px 14px; border: 1px solid #464944; background: #1a1c19; color: var(--text-strong); font-size: var(--project-support-size); line-height: 1.5; }
  .overview-action:hover { border-color: #777a74; background: #242622; }
  .overview-action:focus-visible { outline: 1px solid var(--text); outline-offset: 3px; }
  h3 {
    margin: 0 0 14px;
    color: var(--text-strong);
    font-size: var(--project-heading-size);
    line-height: 1.3;
    font-weight: 400;
    letter-spacing: -.01em;
  }
  .section-body > p {
    max-width: 620px;
    margin: 0;
    color: var(--text);
    font-size: var(--project-body-size);
    line-height: var(--project-body-leading);
  }
  @media (max-width: 620px) {
    .project-overview { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
